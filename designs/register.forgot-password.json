{
  "schema": "plaxtar.designer/v1",
  "screen": "register",
  "state": "forgot-password",
  "fe": "SampleHost",
  "shell": "SampleLayout",
  "root": {
    "element": "div",
    "children": [
      {
        "component": "Card",
        "src": "Components/SampleUi/Card.razor",
        "children": [
          {
            "component": "Stack",
            "src": "Components/SampleUi/Stack.razor",
            "params": {
              "Gap": 14
            },
            "children": [
              {
                "component": "TextField",
                "src": "Components/SampleUi/TextField.razor",
                "params": {
                  "Label": "Email",
                  "Placeholder": "johndoe@gmail.com"
                }
              },
              {
                "component": "TextField",
                "src": "Components/SampleUi/TextField.razor",
                "params": {
                  "Label": "Password",
                  "Placeholder": "*********"
                }
              },
              {
                "component": "Button",
                "src": "Components/SampleUi/Button.razor"
              },
              {
                "element": "section",
                "children": [
                  {
                    "component": "Button",
                    "src": "Components/SampleUi/Button.razor",
                    "params": {
                      "Text": "Forgot Password"
                    }
                  }
                ]
              }
            ]
          }
        ],
        "slots": {
          "HeaderContent": [
            {
              "component": "Badge",
              "src": "Components/SampleUi/Badge.razor",
              "params": {
                "Text": "Login Page"
              }
            }
          ]
        }
      }
    ]
  },
  "overlays": [
    {
      "component": "Modal",
      "src": "Components/SampleUi/Modal.razor",
      "params": {
        "Title": "Forgot Password?"
      },
      "children": [
        {
          "component": "TextField",
          "src": "Components/SampleUi/TextField.razor",
          "params": {
            "Label": "Email",
            "Placeholder": "Please enter your account\u0027s email"
          }
        },
        {
          "component": "Button",
          "src": "Components/SampleUi/Button.razor",
          "params": {
            "Text": "Confirm"
          }
        }
      ]
    }
  ]
}