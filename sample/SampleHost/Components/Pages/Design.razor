@page "/design"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Plaxtar.Designer
@inject ScreenLoader Loader
@inject ComponentTypeResolver Resolver
@inject IWebHostEnvironment Env

@* #2 walking skeleton: render a Design Tree loaded from designs/<screen>.default.json
   (schema plaxtar.designer/v1) via the same TreeNodeRenderer proven in #1. *@

<PageTitle>Design — @(_doc?.Screen ?? "loading")</PageTitle>

@if (_error is not null)
{
    <pre style="color:#b00;padding:20px">@_error</pre>
}
else if (_tree is null)
{
    <p style="padding:20px">loading design…</p>
}
else
{
    <LayoutView Layout="_shellType">
        <TreeNodeRenderer Node="_tree" />
    </LayoutView>
}

@code {
    private DesignNode? _tree;
    private ScreenDoc? _doc;
    private Type _shellType = typeof(SampleHost.SampleUi.SampleLayout);
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var dir = DesignPaths.DesignsDir(Env.ContentRootPath);
            var path = Path.Combine(dir, "audit-log.default.json");
            (_doc, _tree) = await Loader.LoadAsync(path);
            if (_doc.Shell is { } shell) _shellType = Resolver.Resolve(shell);
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
    }
}
