@page "/designer"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SampleHost.Designer
@using Microsoft.AspNetCore.Components.Rendering
@inject DesignSession Session
@inject ComponentCatalog Catalog
@inject ComponentTypeResolver Resolver
@inject ScreenStore Store
@inject IWebHostEnvironment Env
@implements IDisposable

<PageTitle>Composer — @Session.Screen</PageTitle>

<div class="composer">
    <!-- toolbar -->
    <div class="bar">
        <span class="scr">@Session.Screen<span class="st">.@Session.State</span></span>
        <span class="spacer"></span>
        @if (_saved is not null) { <span class="okmsg">saved → @_saved</span> }
        <button class="btn" @onclick="SaveAsync">Save</button>
    </div>

    <div class="split">
        <!-- screens + palette + layers -->
        <div class="pane palette">
            <div class="ph">Screens</div>
            @foreach (var s in _screens)
            {
                <div class="srow @(s.Screen == Session.Screen && s.State == Session.State ? "ssel" : "")">
                    <button class="sopen" @onclick="() => LoadScreenAsync(s)">@s.Screen<span class="sst">.@s.State</span></button>
                    <button class="sdel" title="delete" @onclick="() => DeleteScreenAsync(s)">✕</button>
                </div>
            }
            <div class="newscreen">
                <input placeholder="new screen name" value="@_newName"
                       @oninput="e => _newName = e.Value?.ToString() ?? string.Empty" />
                <button @onclick="NewScreen">+ New</button>
            </div>

            <div class="ph">Catalog</div>
            @foreach (var c in Catalog.Components)
            {
                <button class="pitem" @onclick="() => Session.Add(c.Name)">
                    @c.Name
                    @if (Session.CanContain(c.Name)) { <span class="cc">container</span> }
                </button>
            }

            <div class="ph">Elements</div>
            <button class="pitem" @onclick='() => Session.AddElement("div")'>&lt;div&gt; <span class="cc">container</span></button>
            <button class="pitem" @onclick='() => Session.AddElement("section")'>&lt;section&gt; <span class="cc">container</span></button>

            <div class="ph layers-h">Layers</div>
            @foreach (var (node, depth) in Flatten(Session.Root, 0))
            {
                <button type="button" class="lrow @(Session.SelectedId == node.Id ? "lsel" : "")"
                        style="padding-left:@(depth * 14 + 8)px"
                        @onclick="() => Session.Select(node.Id)">
                    <span class="lname">@node.DisplayName</span>
                    @if (node.Children.Count > 0) { <span class="lc">@node.Children.Count</span> }
                </button>
            }
        </div>

        <!-- canvas -->
        <div class="pane canvas" @onclick="() => Session.Select(null)">
            <LayoutView Layout="_shellType">
                @RenderNode(Session.Root)
            </LayoutView>
        </div>

        <!-- props -->
        <div class="pane props">
            <div class="ph">Properties</div>
            @if (Session.Selected is { } sel)
            {
                <div class="ptarget">
                    @sel.DisplayName
                    <div class="pactions">
                        <button title="up" @onclick="() => Session.Move(sel.Id, -1)">↑</button>
                        <button title="down" @onclick="() => Session.Move(sel.Id, 1)">↓</button>
                        <button title="remove" class="del" @onclick="() => Session.Remove(sel.Id)">✕</button>
                    </div>
                </div>

                @if (sel.IsElement)
                {
                    <div class="prow">
                        <label>class</label>
                        <input type="text" value="@sel.CssClass" placeholder="e.g. grid grid-cols-2 gap-4"
                               @onchange="e => Session.SetClass(sel.Id, e.Value?.ToString())" />
                    </div>
                    <div class="prow">
                        <label>style</label>
                        <input type="text" value="@sel.Style" placeholder="e.g. padding:16px"
                               @onchange="e => Session.SetStyle(sel.Id, e.Value?.ToString())" />
                    </div>
                }
                else
                {
                var editable = EditableParams(sel.Component!);
                @if (editable.Count == 0)
                {
                    <p class="muted">no primitive/enum params</p>
                }
                else
                {
                    @foreach (var pi in editable)
                    {
                        var ptype = ParamType(sel.Component, pi.Name);
                        var current = sel.Params.GetValueOrDefault(pi.Name);
                        <div class="prow">
                            <label>@pi.Name <span class="ptype">@pi.Type</span></label>
                            @if (pi.Kind == ParamKind.Enum)
                            {
                                <select @onchange="e => Session.SetParam(sel.Id, pi.Name, Enum.Parse(Underlying(ptype), e.Value!.ToString()!))">
                                    @foreach (var opt in pi.EnumOptions!)
                                    {
                                        <option value="@opt" selected="@(current?.ToString() == opt)">@opt</option>
                                    }
                                </select>
                            }
                            else if (ptype == typeof(bool))
                            {
                                <input type="checkbox" checked="@((current as bool?) ?? false)"
                                       @onchange="e => Session.SetParam(sel.Id, pi.Name, (bool)e.Value!)" />
                            }
                            else if (IsNumeric(ptype))
                            {
                                <input type="number" value="@current"
                                       @onchange="e => Session.SetParam(sel.Id, pi.Name, ParseNum(ptype, e.Value?.ToString()))" />
                            }
                            else
                            {
                                <input type="text" value="@current"
                                       @onchange="e => Session.SetParam(sel.Id, pi.Name, e.Value?.ToString())" />
                            }
                        </div>
                    }
                }
                }
            }
            else
            {
                <p class="muted">Click a component on the canvas. Click a Catalog item to add it into the selected container.</p>
            }
        </div>
    </div>
</div>

<style>
    .composer { font-family: system-ui, sans-serif; }
    .bar { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-bottom: 1px solid #e2e5ec; background: #fff; }
    .bar .scr { font-family: ui-monospace, monospace; font-size: 13px; }
    .bar .st { color: #8a8f9c; }
    .spacer { flex: 1; }
    .okmsg { font-size: 12px; color: #16884a; }
    .btn { font: inherit; font-size: 13px; font-weight: 550; padding: 6px 14px; border-radius: 7px; border: 1px solid #5b6cf0; background: #5b6cf0; color: #fff; cursor: pointer; }
    .split { display: grid; grid-template-columns: 180px 1fr 240px; height: calc(100vh - 46px); }
    .pane { overflow: auto; }
    .palette { border-right: 1px solid #e2e5ec; background: #fafbfc; padding: 6px; }
    .props { border-left: 1px solid #e2e5ec; background: #fff; padding: 6px 10px; }
    .ph { font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: #8a8f9c; font-weight: 600; padding: 6px 4px; }
    .pitem { display: flex; align-items: center; gap: 6px; width: 100%; text-align: left; font: inherit; font-size: 13px; border: 0; background: transparent; padding: 7px 8px; border-radius: 6px; cursor: pointer; }
    .pitem:hover { background: #eef0f4; }
    .pitem .cc { margin-left: auto; font-size: 9px; color: #5b6cf0; background: #eaecfd; padding: 1px 5px; border-radius: 4px; }
    .srow { display: flex; align-items: center; border-radius: 6px; }
    .srow:hover { background: #eef0f4; }
    .srow.ssel { background: #eaecfd; }
    .srow .sopen { flex: 1; text-align: left; font: inherit; font-family: ui-monospace, monospace; font-size: 12px; border: 0; background: transparent; padding: 6px 8px; cursor: pointer; color: inherit; }
    .srow .sst { color: #8a8f9c; }
    .srow .sdel { border: 0; background: transparent; color: #c0392b; cursor: pointer; padding: 0 8px; opacity: 0; }
    .srow:hover .sdel { opacity: 1; }
    .newscreen { display: flex; gap: 4px; padding: 6px 4px 2px; }
    .newscreen input { flex: 1; min-width: 0; font: inherit; font-size: 12px; padding: 4px 7px; border: 1px solid #e2e5ec; border-radius: 6px; }
    .newscreen button { font: inherit; font-size: 12px; border: 1px solid #5b6cf0; background: #5b6cf0; color: #fff; border-radius: 6px; padding: 4px 8px; cursor: pointer; white-space: nowrap; }
    .layers-h { margin-top: 8px; border-top: 1px solid #e2e5ec; padding-top: 10px; }
    .lrow { display: flex; align-items: center; gap: 6px; width: 100%; text-align: left; border: 0; background: transparent; font-family: ui-monospace, monospace; font-size: 12px; padding: 5px 8px; border-radius: 5px; cursor: pointer; color: inherit; }
    .lrow:hover { background: #eef0f4; }
    .lrow.lsel { background: #eaecfd; color: #4550c8; }
    .lrow .lc { margin-left: auto; font-size: 9px; color: #8a8f9c; background: #eef0f4; padding: 0 5px; border-radius: 8px; }
    .canvas { background: #eef0f4; }
    .ptarget { display: flex; align-items: center; justify-content: space-between; font-family: ui-monospace, monospace; font-size: 13px; color: #5b6cf0; padding: 6px 4px; border-bottom: 1px solid #eef0f4; margin-bottom: 6px; }
    .pactions button { font: inherit; border: 1px solid #e2e5ec; background: #fff; border-radius: 5px; width: 24px; height: 22px; cursor: pointer; margin-left: 2px; }
    .pactions .del { color: #c0392b; border-color: #f3caca; }
    .prow { padding: 6px 4px; }
    .prow label { display: block; font-size: 11px; color: #565a66; margin-bottom: 4px; }
    .prow .ptype { color: #b0b4bd; font-family: ui-monospace, monospace; }
    .prow input[type=text], .prow input[type=number], .prow select { width: 100%; font: inherit; font-size: 13px; padding: 5px 7px; border: 1px solid #e2e5ec; border-radius: 6px; }
    .muted { color: #8a8f9c; font-size: 12.5px; padding: 4px; }

    /* selection wrapper (edit mode only; not exported) */
    .pd-node { position: relative; outline: 1px dashed transparent; border-radius: 4px; }
    .pd-node:hover { outline-color: #b9c0f5; }
    .pd-node.pd-sel { outline: 2px solid #5b6cf0; }
    .pd-empty { display: block; padding: 12px; font: 11px ui-monospace, monospace; color: #a0a4ad; border: 1px dashed #cfd4de; border-radius: 6px; text-align: center; }
    .pd-node > .pd-tag { position: absolute; top: -8px; left: 6px; font: 10px ui-monospace, monospace; background: #5b6cf0; color: #fff; padding: 1px 5px; border-radius: 4px; opacity: 0; pointer-events: none; z-index: 2; }
    .pd-node:hover > .pd-tag, .pd-node.pd-sel > .pd-tag { opacity: 1; }
</style>

@code {
    private Type _shellType = typeof(SampleHost.SampleUi.SampleLayout);
    private string? _saved;

    private string _designsDir = "";
    private List<ScreenRef> _screens = new();
    private string _newName = "";

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        _designsDir = DesignPaths.DesignsDir(Env.ContentRootPath);
        RefreshScreens();
        await Session.LoadAsync(Path.Combine(_designsDir, "audit-log.default.json"));
        ApplyShell();
    }

    private void RefreshScreens() => _screens = Store.List(_designsDir).ToList();
    private void ApplyShell() { if (Session.Shell is { } s) _shellType = Resolver.Resolve(s); }

    private async Task LoadScreenAsync(ScreenRef s)
    {
        await Session.LoadAsync(Path.Combine(_designsDir, s.FileBase + ".json"));
        ApplyShell();
        _saved = null;
    }

    private void NewScreen()
    {
        Session.New(_newName, "SampleLayout");
        _shellType = typeof(SampleHost.SampleUi.SampleLayout);
        _newName = "";
    }

    private void DeleteScreenAsync(ScreenRef s)
    {
        Store.Delete(_designsDir, s.FileBase);
        RefreshScreens();
    }

    private void OnChanged() { _saved = null; InvokeAsync(StateHasChanged); }

    private async Task SaveAsync()
    {
        _saved = Path.GetFileName(await Session.SaveAsync(_designsDir));
        RefreshScreens();
        StateHasChanged();
    }

    // Canvas tree rendered inline by the page so click handlers are page-bound
    // (interactive), not authored inside a child component (which isn't).
    private RenderFragment RenderNode(EditableNode node) => builder =>
    {
        var selected = Session.SelectedId == node.Id;

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "pd-node" + (selected ? " pd-sel" : ""));
        builder.AddAttribute(2, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => Session.Select(node.Id)));
        builder.AddEventStopPropagationAttribute(3, "onclick", true);

        builder.OpenElement(4, "span");
        builder.AddAttribute(5, "class", "pd-tag");
        builder.AddContent(6, node.DisplayName);
        builder.CloseElement();

        if (node.IsElement)
        {
            builder.OpenElement(7, node.Element!);
            if (!string.IsNullOrWhiteSpace(node.CssClass)) builder.AddAttribute(8, "class", node.CssClass);
            if (!string.IsNullOrWhiteSpace(node.Style)) builder.AddAttribute(9, "style", node.Style);
            if (node.Children.Count == 0)
            {
                builder.OpenElement(10, "span");
                builder.AddAttribute(11, "class", "pd-empty");
                builder.AddContent(12, $"empty <{node.Element}> — add into it");
                builder.CloseElement();
            }
            else
            {
                foreach (var child in node.Children) builder.AddContent(13, RenderNode(child));
            }
            builder.CloseElement();
        }
        else
        {
            var type = Resolver.Resolve(node.Component!);
            builder.OpenComponent<DynamicComponent>(14);
            builder.AddComponentParameter(15, "Type", type);
            builder.AddComponentParameter(16, "Parameters", BuildParams(node, type));
            builder.CloseComponent();
        }

        builder.CloseElement();
    };

    private Dictionary<string, object?> BuildParams(EditableNode node, Type type)
    {
        var p = new Dictionary<string, object?>(node.Params);
        var hasChildContent = type.GetProperty("ChildContent") is not null;

        if (node.Children.Count > 0 && hasChildContent)
        {
            p["ChildContent"] = (RenderFragment)(b =>
            {
                foreach (var child in node.Children)
                    b.AddContent(0, RenderNode(child));
            });
        }
        else if (hasChildContent)
        {
            p["ChildContent"] = (RenderFragment)(b =>
            {
                b.OpenElement(0, "span");
                b.AddAttribute(1, "class", "pd-empty");
                b.AddContent(2, $"empty {node.Component} — add into it");
                b.CloseElement();
            });
        }
        return p;
    }

    private IEnumerable<(EditableNode node, int depth)> Flatten(EditableNode n, int depth)
    {
        yield return (n, depth);
        foreach (var child in n.Children)
            foreach (var pair in Flatten(child, depth + 1))
                yield return pair;
    }

    private List<ParamInfo> EditableParams(string component) =>
        Session.Info(component)?.Params
            .Where(p => p.Kind is ParamKind.Primitive or ParamKind.Enum)
            .ToList() ?? new();

    private Type ParamType(string component, string name) =>
        Resolver.Resolve(component).GetProperty(name)!.PropertyType;

    private static Type Underlying(Type t) => Nullable.GetUnderlyingType(t) ?? t;

    private static bool IsNumeric(Type t)
    {
        var u = Underlying(t);
        return u == typeof(int) || u == typeof(long) || u == typeof(double) || u == typeof(decimal) || u == typeof(float);
    }

    private static object? ParseNum(Type t, string? s)
    {
        var u = Underlying(t);
        if (string.IsNullOrWhiteSpace(s)) return null;
        return u == typeof(int) ? int.Parse(s)
             : u == typeof(long) ? long.Parse(s)
             : u == typeof(double) ? double.Parse(s)
             : u == typeof(float) ? float.Parse(s)
             : u == typeof(decimal) ? decimal.Parse(s)
             : s;
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
