@namespace SampleHost.SampleUi

<span class="badge b-@Variant.ToString().ToLowerInvariant()" @onclick="OnClick">@Text</span>

<style>
    .badge { display: inline-block; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px; cursor: pointer; }
    .badge.b-ok { background: #e9f7ee; color: #16884a; }
    .badge.b-warn { background: #fdeede; color: #b5721c; }
    .badge.b-danger { background: #fde8e8; color: #c0392b; }
</style>

@code {
    public enum BadgeVariant { Ok, Warn, Danger }

    [Parameter] public string Text { get; set; } = "badge";       // primitive
    [Parameter] public BadgeVariant Variant { get; set; } = BadgeVariant.Ok;  // enum
    [Parameter] public EventCallback OnClick { get; set; }        // event
}
