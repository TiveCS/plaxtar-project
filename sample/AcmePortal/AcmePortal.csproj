<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Plaxtar Composer, dev-only (see the package README). Referenced + compiled in
       only for Debug; a Release build has no Plaxtar.Designer assembly and no route. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\..\src\Plaxtar.Designer\Plaxtar.Designer.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);PLAXTAR_DESIGNER</DefineConstants>
  </PropertyGroup>

</Project>
