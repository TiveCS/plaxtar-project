<Router AppAssembly="typeof(Program).Assembly"
        AdditionalAssemblies="AcmePortal.DesignerRouting.AdditionalAssemblies"
        NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(AcmePortal.Layout.PortalLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
