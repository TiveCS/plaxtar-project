    // Preview top-bar auto-hide (ADR 0006): hide after 3s idle, reveal on top-edge hover.
    private void TogglePreview()
    {
        _preview = !_preview;
        _barHidden = false;
        if (_preview) HideBarSoon(); else CancelBarTimer();
    }

    private void ShowBar()
    {
        CancelBarTimer();
        if (_barHidden) { _barHidden = false; StateHasChanged(); }
    }

    private void HideBarSoon()
    {
        if (!_preview) return;
        CancelBarTimer();
        _barCts = new CancellationTokenSource();
        var tok = _barCts.Token;
        _ = Task.Run(async () =>
        {
            try { await Task.Delay(3000, tok); } catch { return; }
            if (!tok.IsCancellationRequested)
                await InvokeAsync(() => { _barHidden = true; StateHasChanged(); });
        });
    }

    private void CancelBarTimer() { _barCts?.Cancel(); _barCts = null; }

