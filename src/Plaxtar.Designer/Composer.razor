    private Dictionary<string, object?> BuildParams(EditableNode node, Type type, bool preview = false)
    {
        var p = new Dictionary<string, object?>();

        // Literal params. Complex-object markers ($bind/$raw) are design-time only —
        // they can't be materialized, so skip them (the component uses its default).
        foreach (var (k, v) in node.Params)
        {
            if (v is BindExpr or RawExpr) continue;
            p[k] = v;
        }

        // @bind params: seed ephemeral local state so a bound input is previewable.
        // Never exported — bindings serialize under `bindings`, not `params`.
        foreach (var (name, _) in node.Bindings)
        {
            var prop = type.GetProperty(name);
            if (prop is null) continue;
            var key = $"{node.Id}:{name}";
            p[name] = _ephemeral.TryGetValue(key, out var val) ? val : DefaultOf(prop.PropertyType);
        }

        if (type.GetProperty("ChildContent") is not null)
        {
            if (node.Children.Count > 0)
                p["ChildContent"] = preview ? RawFrag(node.Children) : Frag(node.Children);
            else if (!preview)
                p["ChildContent"] = EmptyFrag($"empty {node.Component} — add into it");
        }

        foreach (var (slot, kids) in node.Slots)
            if (kids.Count > 0 && type.GetProperty(slot) is not null)
                p[slot] = preview ? RawFrag(kids) : Frag(kids);

        return p;
    }

    private RenderFragment RawFrag(List<EditableNode> kids) => b =>
    {
        var seq = 0;
        foreach (var child in kids) b.AddContent(seq++, RenderRaw(child));
    };

    private readonly Dictionary<string, object?> _ephemeral = new();

    private static object? DefaultOf(Type t) =>
        t == typeof(string) ? "" :
        (Nullable.GetUnderlyingType(t) is null && t.IsValueType ? Activator.CreateInstance(t) : null);

    private RenderFragment Frag(List<EditableNode> kids) => b =>
    {
        var seq = 0;
        foreach (var child in kids) b.AddContent(seq++, RenderNode(child));
    };

    private RenderFragment EmptyFrag(string text) => b =>
    {
        b.OpenElement(0, "span");
        b.AddAttribute(1, "class", "pd-empty");
        b.AddContent(2, text);
        b.CloseElement();
    };

    private IEnumerable<(EditableNode node, int depth)> Flatten(EditableNode n, int depth)
    {
        yield return (n, depth);
        foreach (var child in n.AllChildren)
            foreach (var pair in Flatten(child, depth + 1))
                yield return pair;
    }

    private List<ParamInfo> EditableParams(string component) =>
        Session.Info(component)?.Params
            .Where(p => p.Kind is ParamKind.Primitive or ParamKind.Enum)
            .ToList() ?? new();

    private static string LV(EditableNode n, string key) => n.Layout.GetValueOrDefault(key) ?? "";

    // <option> list for a layout select: a "(unset)" entry plus each choice, current selected.
    private RenderFragment LayoutOptions(string current, params string[] opts) => b =>
    {
        b.OpenElement(0, "option");
        b.AddAttribute(1, "value", "");
        if (string.IsNullOrEmpty(current)) b.AddAttribute(2, "selected", true);
        b.AddContent(3, "(unset)");
        b.CloseElement();
        foreach (var o in opts)
        {
            b.OpenElement(4, "option");
            b.AddAttribute(5, "value", o);
            if (current == o) b.AddAttribute(6, "selected", true);
            b.AddContent(7, o);
            b.CloseElement();
        }
    };

    private void ClearLayout(string id) => Session.ClearLayout(id);

    private void Preset(string id, params (string key, string val)[] kv)
    {
        Session.ClearLayout(id);
        foreach (var (k, v) in kv) Session.SetLayout(id, k, v);
    }

    private List<ParamInfo> EventParams(string component) =>
        Session.Info(component)?.Params.Where(p => p.Kind == ParamKind.Event).ToList() ?? new();

    private List<ParamInfo> ComplexParams(string component) =>
        Session.Info(component)?.Params.Where(p => p.Kind == ParamKind.Complex).ToList() ?? new();

    private static object? MakeBind(string? field) => string.IsNullOrWhiteSpace(field) ? null : new BindExpr(field.Trim());
    private static object? MakeRaw(string? code) => string.IsNullOrWhiteSpace(code) ? null : new RawExpr(code.Trim());

    private Type ParamType(string component, string name) =>
        Resolver.Resolve(component).GetProperty(name)!.PropertyType;

    private static Type Underlying(Type t) => Nullable.GetUnderlyingType(t) ?? t;

    private static bool IsNumeric(Type t)
    {
        var u = Underlying(t);
        return u == typeof(int) || u == typeof(long) || u == typeof(double) || u == typeof(decimal) || u == typeof(float);
    }

    private static object? ParseNum(Type t, string? s)
    {
        var u = Underlying(t);
        if (string.IsNullOrWhiteSpace(s)) return null;
        return u == typeof(int) ? int.Parse(s)
             : u == typeof(long) ? long.Parse(s)
             : u == typeof(double) ? double.Parse(s)
             : u == typeof(float) ? float.Parse(s)
             : u == typeof(decimal) ? decimal.Parse(s)
             : s;
    }

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        CancelBarTimer();
        _dotnetRef?.Dispose();
        _ = _dragMod?.DisposeAsync().AsTask();
    }
}
