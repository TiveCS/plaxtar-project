@page "/designer"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject DesignSession Session
@inject ComponentCatalog Catalog
@inject ComponentTypeResolver Resolver
@inject ScreenStore Store
@inject PlaxtarDesignerOptions Options
@inject IWebHostEnvironment Env
@implements IDisposable

<PageTitle>Composer — @Session.Screen</PageTitle>

<div class="composer">
    <!-- toolbar -->
    <div class="bar">
        <span class="scr">@Session.Screen<span class="st">.@Session.State</span></span>
        <span class="spacer"></span>
        @if (_saved is not null) { <span class="okmsg">saved → @_saved</span> }
        <button class="btn2 @(_preview ? "on" : "")" @onclick="() => _preview = !_preview"
                title="Preview = raw, full-width, true-fidelity render (non-interactive)">
            @(_preview ? "✎ Edit" : "◱ Preview")
        </button>
        <button class="btn" @onclick="SaveAsync">Save</button>
    </div>

    <div class="split @(_preview ? "preview" : "")">
        <!-- screens + palette + layers -->
        <div class="pane palette">
            <div class="ph">Screens</div>
            @foreach (var s in _screens)
            {
                <div class="srow @(s.Screen == Session.Screen && s.State == Session.State ? "ssel" : "")">
                    <button class="sopen" @onclick="() => LoadScreenAsync(s)">@s.Screen<span class="sst">.@s.State</span></button>
                    <button class="sdel" title="delete" @onclick="() => DeleteScreenAsync(s)">✕</button>
                </div>
            }
            <div class="newscreen">
                <input placeholder="new screen name" value="@_newName"
                       @oninput="e => _newName = e.Value?.ToString() ?? string.Empty" />
                <button @onclick="NewScreen">+ New</button>
            </div>

            <div class="ph">States</div>
            <div class="statepick">
                @foreach (var st in StatesForCurrentScreen())
                {
                    <button class="slotbtn @(st == Session.State ? "act" : "")"
                            @onclick="() => SwitchStateAsync(st)">@st</button>
                }
            </div>
            <div class="newscreen">
                <input placeholder="new state (e.g. modal-open)" value="@_newState"
                       @oninput="e => _newState = e.Value?.ToString() ?? string.Empty" />
                <button @onclick="AddState">+ State</button>
            </div>
            @if (Session.State != "default")
            {
                <div class="newscreen">
                    <input placeholder="rename @Session.State" value="@_renameState"
                           @oninput="e => _renameState = e.Value?.ToString() ?? string.Empty" />
                    <button @onclick="() => RenameStateAsync(_renameState)">Rename</button>
                </div>
            }

            <div class="ph">Catalog</div>
            @foreach (var c in Catalog.Components)
            {
                <div class="pcat">
                    <button class="pitem" @onclick="() => Session.Add(c.Name)">
                        @c.Name
                        @if (Session.CanContain(c.Name)) { <span class="cc">container</span> }
                    </button>
                    <button class="ovbtn" title="add as overlay" @onclick="() => Session.AddOverlay(c.Name)">⧉</button>
                </div>
            }

            <div class="ph">Elements</div>
            <button class="pitem" @onclick='() => Session.AddElement("div")'>&lt;div&gt; <span class="cc">container</span></button>
            <button class="pitem" @onclick='() => Session.AddElement("section")'>&lt;section&gt; <span class="cc">container</span></button>

            <div class="ph layers-h">Layers</div>
            @foreach (var (node, depth) in Flatten(Session.Root, 0))
            {
                <button type="button" class="lrow @(Session.SelectedId == node.Id ? "lsel" : "")"
                        style="padding-left:@(depth * 14 + 8)px"
                        @onclick="() => Session.Select(node.Id)">
                    <span class="lname">@node.DisplayName</span>
                    @if (node.Children.Count > 0) { <span class="lc">@node.Children.Count</span> }
                </button>
            }
            @if (Session.Overlays.Count > 0)
            {
                <div class="ph layers-h">Overlays</div>
                @foreach (var ov in Session.Overlays)
                {
                    @foreach (var (node, depth) in Flatten(ov, 0))
                    {
                        <button type="button" class="lrow @(Session.SelectedId == node.Id ? "lsel" : "")"
                                style="padding-left:@(depth * 14 + 8)px"
                                @onclick="() => Session.Select(node.Id)">
                            <span class="lname">@node.DisplayName</span>
                            @if (node.Children.Count > 0) { <span class="lc">@node.Children.Count</span> }
                        </button>
                    }
                }
            }
        </div>

        <!-- canvas -->
        <div class="pane canvas" @onclick="() => Session.Select(null)">
            <LayoutView Layout="_shellType">
                @(_preview ? RenderRaw(Session.Root) : RenderNode(Session.Root))
            </LayoutView>
            @if (Session.Overlays.Count > 0)
            {
                <div class="ov-layer">
                    @foreach (var ov in Session.Overlays)
                    {
                        <div class="ov-item">@(_preview ? RenderRaw(ov) : RenderNode(ov))</div>
                    }
                </div>
            }
        </div>

        <!-- props -->
        <div class="pane props">
            <div class="ph">Properties</div>
            @if (Session.Selected is { } sel)
            {
                <div class="ptarget">
                    @sel.DisplayName
                    <div class="pactions">
                        <button title="up" @onclick="() => Session.Move(sel.Id, -1)">↑</button>
                        <button title="down" @onclick="() => Session.Move(sel.Id, 1)">↓</button>
                        <button title="remove" class="del" @onclick="() => Session.Remove(sel.Id)">✕</button>
                    </div>
                </div>

                @if (sel.IsElement)
                {
                    var disp = LV(sel, "display");
                    var pos = LV(sel, "position");
                    <div class="ph slots-h">Layout</div>
                    <div class="slotpick">
                        <button class="slotbtn" @onclick="() => ClearLayout(sel.Id)">clear</button>
                        <button class="slotbtn" @onclick='() => Preset(sel.Id, ("display","flex"),("direction","row"),("gap","12px"))'>flex row</button>
                        <button class="slotbtn" @onclick='() => Preset(sel.Id, ("display","flex"),("direction","column"),("gap","12px"))'>flex col</button>
                        <button class="slotbtn" @onclick='() => Preset(sel.Id, ("display","grid"),("columns","repeat(2,1fr)"),("gap","12px"))'>grid 2</button>
                        <button class="slotbtn" @onclick='() => Preset(sel.Id, ("display","grid"),("columns","repeat(3,1fr)"),("gap","12px"))'>grid 3</button>
                    </div>

                    <div class="prow">
                        <label>display</label>
                        <select @onchange='e => Session.SetLayout(sel.Id, "display", e.Value?.ToString())'>
                            @LayoutOptions(disp, "block", "flex", "inline-flex", "grid", "none")
                        </select>
                    </div>

                    @if (disp is "flex" or "inline-flex")
                    {
                        <div class="prow">
                            <label>direction</label>
                            <select @onchange='e => Session.SetLayout(sel.Id, "direction", e.Value?.ToString())'>
                                @LayoutOptions(LV(sel, "direction"), "row", "column")
                            </select>
                        </div>
                        <div class="prow">
                            <label>wrap</label>
                            <select @onchange='e => Session.SetLayout(sel.Id, "wrap", e.Value?.ToString())'>
                                @LayoutOptions(LV(sel, "wrap"), "nowrap", "wrap")
                            </select>
                        </div>
                        <div class="prow">
                            <label>justify</label>
                            <select @onchange='e => Session.SetLayout(sel.Id, "justify", e.Value?.ToString())'>
                                @LayoutOptions(LV(sel, "justify"), "start", "center", "end", "space-between", "space-around")
                            </select>
                        </div>
                        <div class="prow">
                            <label>align</label>
                            <select @onchange='e => Session.SetLayout(sel.Id, "align", e.Value?.ToString())'>
                                @LayoutOptions(LV(sel, "align"), "stretch", "start", "center", "end")
                            </select>
                        </div>
                    }
                    @if (disp == "grid")
                    {
                        <div class="prow">
                            <label>columns</label>
                            <input type="text" value="@LV(sel, "columns")" placeholder="repeat(2,1fr)"
                                   @onchange='e => Session.SetLayout(sel.Id, "columns", e.Value?.ToString())' />
                        </div>
                        <div class="prow">
                            <label>rows</label>
                            <input type="text" value="@LV(sel, "rows")" placeholder="auto"
                                   @onchange='e => Session.SetLayout(sel.Id, "rows", e.Value?.ToString())' />
                        </div>
                    }
                    @if (disp is "flex" or "inline-flex" or "grid")
                    {
                        <div class="prow">
                            <label>gap</label>
                            <input type="text" value="@LV(sel, "gap")" placeholder="12px"
                                   @onchange='e => Session.SetLayout(sel.Id, "gap", e.Value?.ToString())' />
                        </div>
                    }

                    <div class="ph slots-h">Size &amp; spacing</div>
                    <div class="lgrid">
                        <div><label>width</label><input type="text" value="@LV(sel, "width")" placeholder="auto / 100% / 320px"
                                @onchange='e => Session.SetLayout(sel.Id, "width", e.Value?.ToString())' /></div>
                        <div><label>min</label><input type="text" value="@LV(sel, "minWidth")" placeholder="min-width"
                                @onchange='e => Session.SetLayout(sel.Id, "minWidth", e.Value?.ToString())' /></div>
                        <div><label>max</label><input type="text" value="@LV(sel, "maxWidth")" placeholder="max-width"
                                @onchange='e => Session.SetLayout(sel.Id, "maxWidth", e.Value?.ToString())' /></div>
                        <div><label>padding</label><input type="text" value="@LV(sel, "padding")" placeholder="16px"
                                @onchange='e => Session.SetLayout(sel.Id, "padding", e.Value?.ToString())' /></div>
                        <div><label>margin</label><input type="text" value="@LV(sel, "margin")" placeholder="0 auto"
                                @onchange='e => Session.SetLayout(sel.Id, "margin", e.Value?.ToString())' /></div>
                    </div>

                    <div class="ph slots-h">Position</div>
                    <div class="prow">
                        <select @onchange='e => Session.SetLayout(sel.Id, "position", e.Value?.ToString())'>
                            @LayoutOptions(pos, "static", "relative", "sticky", "fixed", "absolute")
                        </select>
                    </div>
                    @if (pos is not ("" or "static"))
                    {
                        <div class="lgrid">
                            <div><label>top</label><input type="text" value="@LV(sel, "top")"
                                    @onchange='e => Session.SetLayout(sel.Id, "top", e.Value?.ToString())' /></div>
                            <div><label>right</label><input type="text" value="@LV(sel, "right")"
                                    @onchange='e => Session.SetLayout(sel.Id, "right", e.Value?.ToString())' /></div>
                            <div><label>bottom</label><input type="text" value="@LV(sel, "bottom")"
                                    @onchange='e => Session.SetLayout(sel.Id, "bottom", e.Value?.ToString())' /></div>
                            <div><label>left</label><input type="text" value="@LV(sel, "left")"
                                    @onchange='e => Session.SetLayout(sel.Id, "left", e.Value?.ToString())' /></div>
                        </div>
                    }

                    <div class="ph slots-h">Escape hatches</div>
                    <div class="prow">
                        <label>class</label>
                        <input type="text" value="@sel.CssClass" placeholder="e.g. grid grid-cols-2 gap-4"
                               @onchange="e => Session.SetClass(sel.Id, e.Value?.ToString())" />
                    </div>
                    <div class="prow">
                        <label>style (raw, wins)</label>
                        <input type="text" value="@sel.Style" placeholder="e.g. box-shadow:0 1px 2px #0002"
                               @onchange="e => Session.SetStyle(sel.Id, e.Value?.ToString())" />
                    </div>
                }
                else
                {
                var slots = Session.NamedSlots(sel.Component);
                var hasCC = Session.CanContain(sel.Component!);
                @if (hasCC || slots.Count > 0)
                {
                    <div class="ph slots-h">Insert into</div>
                    <div class="slotpick">
                        @if (hasCC)
                        {
                            <button class="slotbtn @(Session.ActiveSlot is null ? "act" : "")"
                                    @onclick="() => Session.SelectSlot(null)">ChildContent (@sel.Children.Count)</button>
                        }
                        @foreach (var sn in slots)
                        {
                            var cnt = sel.Slots.TryGetValue(sn, out var l) ? l.Count : 0;
                            <button class="slotbtn @(Session.ActiveSlot == sn ? "act" : "")"
                                    @onclick="() => Session.SelectSlot(sn)">@sn (@cnt)</button>
                        }
                    </div>
                }

                var editable = EditableParams(sel.Component!);
                @if (editable.Count == 0)
                {
                    <p class="muted">no primitive/enum params</p>
                }
                else
                {
                    @foreach (var pi in editable)
                    {
                        var ptype = ParamType(sel.Component, pi.Name);
                        var current = sel.Params.GetValueOrDefault(pi.Name);
                        <div class="prow">
                            <label>@pi.Name <span class="ptype">@pi.Type</span></label>
                            @if (pi.Kind == ParamKind.Enum)
                            {
                                <select @onchange="e => Session.SetParam(sel.Id, pi.Name, Enum.Parse(Underlying(ptype), e.Value!.ToString()!))">
                                    @foreach (var opt in pi.EnumOptions!)
                                    {
                                        <option value="@opt" selected="@(current?.ToString() == opt)">@opt</option>
                                    }
                                </select>
                            }
                            else if (ptype == typeof(bool))
                            {
                                <input type="checkbox" checked="@((current as bool?) ?? false)"
                                       @onchange="e => Session.SetParam(sel.Id, pi.Name, (bool)e.Value!)" />
                            }
                            else if (IsNumeric(ptype))
                            {
                                <input type="number" value="@current"
                                       @onchange="e => Session.SetParam(sel.Id, pi.Name, ParseNum(ptype, e.Value?.ToString()))" />
                            }
                            else
                            {
                                <input type="text" value="@current"
                                       @onchange="e => Session.SetParam(sel.Id, pi.Name, e.Value?.ToString())" />
                            }
                            @if (pi.Bindable)
                            {
                                <input class="bindbox" type="text" placeholder="@("@bind") → field"
                                       value="@(sel.Bindings.GetValueOrDefault(pi.Name))"
                                       @onchange="e => Session.SetBinding(sel.Id, pi.Name, e.Value?.ToString())" />
                            }
                        </div>
                    }
                }

                var events = EventParams(sel.Component!);
                @if (events.Count > 0)
                {
                    <div class="ph slots-h">Events</div>
                    @foreach (var ev in events)
                    {
                        <div class="prow">
                            <label>@ev.Name <span class="ptype">@ev.Type</span></label>
                            <input type="text" placeholder="handler name e.g. HandleClick"
                                   value="@(sel.Events.GetValueOrDefault(ev.Name))"
                                   @onchange="e => Session.SetEvent(sel.Id, ev.Name, e.Value?.ToString())" />
                        </div>
                    }
                }

                var complex = ComplexParams(sel.Component!);
                @if (complex.Count > 0)
                {
                    <div class="ph slots-h">Complex</div>
                    @foreach (var cp in complex)
                    {
                        var cur = sel.Params.GetValueOrDefault(cp.Name);
                        <div class="prow">
                            <label>@cp.Name <span class="ptype">@cp.Type</span></label>
                            <input type="text" placeholder="$bind → field"
                                   value="@((cur as BindExpr)?.Field)"
                                   @onchange="e => Session.SetComplex(sel.Id, cp.Name, MakeBind(e.Value?.ToString()))" />
                            <input class="rawbox" type="text" placeholder="$raw → new Foo{ }"
                                   value="@((cur as RawExpr)?.Code)"
                                   @onchange="e => Session.SetComplex(sel.Id, cp.Name, MakeRaw(e.Value?.ToString()))" />
                        </div>
                    }
                }
                }
            }
            else
            {
                <p class="muted">Click a component on the canvas. Click a Catalog item to add it into the selected container.</p>
            }
        </div>
    </div>
</div>

<style>
    .composer { font-family: system-ui, sans-serif; }
    .bar { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-bottom: 1px solid #e2e5ec; background: #fff; }
    .bar .scr { font-family: ui-monospace, monospace; font-size: 13px; }
    .bar .st { color: #8a8f9c; }
    .spacer { flex: 1; }
    .okmsg { font-size: 12px; color: #16884a; }
    .btn { font: inherit; font-size: 13px; font-weight: 550; padding: 6px 14px; border-radius: 7px; border: 1px solid #5b6cf0; background: #5b6cf0; color: #fff; cursor: pointer; }
    .btn2 { font: inherit; font-size: 13px; font-weight: 550; padding: 6px 12px; border-radius: 7px; border: 1px solid #d5d9e2; background: #fff; color: #565a66; cursor: pointer; }
    .btn2.on { border-color: #5b6cf0; background: #eaecfd; color: #4550c8; }
    .split { display: grid; grid-template-columns: 180px 1fr 240px; height: calc(100vh - 46px); }
    .split.preview { grid-template-columns: 0 1fr 0; }
    .split.preview .palette, .split.preview .props { display: none; }
    .pane { overflow: auto; }
    .palette { border-right: 1px solid #e2e5ec; background: #fafbfc; padding: 6px; }
    .props { border-left: 1px solid #e2e5ec; background: #fff; padding: 6px 10px; }
    .ph { font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: #8a8f9c; font-weight: 600; padding: 6px 4px; }
    .pitem { display: flex; align-items: center; gap: 6px; width: 100%; text-align: left; font: inherit; font-size: 13px; border: 0; background: transparent; padding: 7px 8px; border-radius: 6px; cursor: pointer; }
    .pitem:hover { background: #eef0f4; }
    .pitem .cc { margin-left: auto; font-size: 9px; color: #5b6cf0; background: #eaecfd; padding: 1px 5px; border-radius: 4px; }
    .srow { display: flex; align-items: center; border-radius: 6px; }
    .srow:hover { background: #eef0f4; }
    .srow.ssel { background: #eaecfd; }
    .srow .sopen { flex: 1; text-align: left; font: inherit; font-family: ui-monospace, monospace; font-size: 12px; border: 0; background: transparent; padding: 6px 8px; cursor: pointer; color: inherit; }
    .srow .sst { color: #8a8f9c; }
    .srow .sdel { border: 0; background: transparent; color: #c0392b; cursor: pointer; padding: 0 8px; opacity: 0; }
    .srow:hover .sdel { opacity: 1; }
    .newscreen { display: flex; gap: 4px; padding: 6px 4px 2px; }
    .newscreen input { flex: 1; min-width: 0; font: inherit; font-size: 12px; padding: 4px 7px; border: 1px solid #e2e5ec; border-radius: 6px; }
    .newscreen button { font: inherit; font-size: 12px; border: 1px solid #5b6cf0; background: #5b6cf0; color: #fff; border-radius: 6px; padding: 4px 8px; cursor: pointer; white-space: nowrap; }
    .layers-h { margin-top: 8px; border-top: 1px solid #e2e5ec; padding-top: 10px; }
    .lrow { display: flex; align-items: center; gap: 6px; width: 100%; text-align: left; border: 0; background: transparent; font-family: ui-monospace, monospace; font-size: 12px; padding: 5px 8px; border-radius: 5px; cursor: pointer; color: inherit; }
    .lrow:hover { background: #eef0f4; }
    .lrow.lsel { background: #eaecfd; color: #4550c8; }
    .lrow .lc { margin-left: auto; font-size: 9px; color: #8a8f9c; background: #eef0f4; padding: 0 5px; border-radius: 8px; }
    .canvas { background: #eef0f4; position: relative; }
    .statepick { display: flex; flex-wrap: wrap; gap: 4px; padding: 2px 4px 4px; }
    .pcat { display: flex; align-items: center; gap: 2px; }
    .pcat .pitem { flex: 1; }
    .ovbtn { font-size: 12px; border: 1px solid #e2e5ec; background: #fff; color: #8a8f9c; border-radius: 5px; width: 24px; height: 26px; cursor: pointer; }
    .ovbtn:hover { border-color: #5b6cf0; color: #5b6cf0; }
    .ov-layer { position: absolute; inset: 0; background: rgba(20,24,40,.28); display: flex; align-items: center; justify-content: center; padding: 24px; z-index: 5; }
    .ov-item { max-width: 90%; }
    .ptarget { display: flex; align-items: center; justify-content: space-between; font-family: ui-monospace, monospace; font-size: 13px; color: #5b6cf0; padding: 6px 4px; border-bottom: 1px solid #eef0f4; margin-bottom: 6px; }
    .pactions button { font: inherit; border: 1px solid #e2e5ec; background: #fff; border-radius: 5px; width: 24px; height: 22px; cursor: pointer; margin-left: 2px; }
    .pactions .del { color: #c0392b; border-color: #f3caca; }
    .slots-h { margin-top: 4px; }
    .slotpick { display: flex; flex-wrap: wrap; gap: 4px; padding: 2px 4px 8px; }
    .slotbtn { font: inherit; font-size: 11px; font-family: ui-monospace, monospace; border: 1px solid #e2e5ec; background: #fff; color: #565a66; border-radius: 6px; padding: 4px 8px; cursor: pointer; }
    .slotbtn.act { border-color: #5b6cf0; background: #eaecfd; color: #4550c8; }
    .prow { padding: 6px 4px; }
    .prow label { display: block; font-size: 11px; color: #565a66; margin-bottom: 4px; }
    .prow .ptype { color: #b0b4bd; font-family: ui-monospace, monospace; }
    .prow input[type=text], .prow input[type=number], .prow select { width: 100%; font: inherit; font-size: 13px; padding: 5px 7px; border: 1px solid #e2e5ec; border-radius: 6px; }
    .prow .bindbox, .prow .rawbox { margin-top: 4px; font-family: ui-monospace, monospace; font-size: 12px; border-style: dashed; border-color: #c3b6ef; background: #faf9ff; }
    .lgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 2px 4px; }
    .lgrid label { display: block; font-size: 11px; color: #565a66; margin-bottom: 3px; }
    .lgrid input { width: 100%; font: inherit; font-size: 12.5px; font-family: ui-monospace, monospace; padding: 4px 6px; border: 1px solid #e2e5ec; border-radius: 6px; }
    .muted { color: #8a8f9c; font-size: 12.5px; padding: 4px; }

    /* selection wrapper (edit mode only; not exported) */
    .pd-node { position: relative; outline: 1px dashed transparent; border-radius: 4px; }
    .pd-node:hover { outline-color: #b9c0f5; }
    .pd-node.pd-sel { outline: 2px solid #5b6cf0; }
    .pd-empty { display: block; padding: 12px; font: 11px ui-monospace, monospace; color: #a0a4ad; border: 1px dashed #cfd4de; border-radius: 6px; text-align: center; }
    .pd-node > .pd-tag { position: absolute; top: -8px; left: 6px; font: 10px ui-monospace, monospace; background: #5b6cf0; color: #fff; padding: 1px 5px; border-radius: 4px; opacity: 0; pointer-events: none; z-index: 2; }
    .pd-node:hover > .pd-tag, .pd-node.pd-sel > .pd-tag { opacity: 1; }
</style>

@code {
    private Type? _shellType;
    private bool _preview;      // true = raw, full-width, true-fidelity render (ADR 0005)
    private string? _saved;

    private string _designsDir = "";
    private List<ScreenRef> _screens = new();
    private string _newName = "";
    private string _newState = "";
    private string _renameState = "";

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        _designsDir = DesignPaths.DesignsDir(Env.ContentRootPath);
        RefreshScreens();

        // Open the first existing screen; otherwise start a fresh untitled one.
        if (_screens.FirstOrDefault() is { } first)
            await Session.LoadAsync(Path.Combine(_designsDir, first.FileBase + ".json"));
        else
            Session.New("untitled", Options.DefaultShellName);
        ApplyShell();
    }

    private void RefreshScreens() => _screens = Store.List(_designsDir).ToList();
    private void ApplyShell() => _shellType = Session.Shell is { } s ? Resolver.Resolve(s) : null;

    private async Task LoadScreenAsync(ScreenRef s)
    {
        await Session.LoadAsync(Path.Combine(_designsDir, s.FileBase + ".json"));
        ApplyShell();
        _saved = null;
    }

    private void NewScreen()
    {
        Session.New(_newName, Options.DefaultShellName);
        ApplyShell();
        _newName = "";
    }

    // States of the current screen: those saved on disk, plus `default` and the
    // in-memory current state (which may be unsaved yet).
    private IEnumerable<string> StatesForCurrentScreen()
    {
        var states = _screens.Where(s => s.Screen == Session.Screen).Select(s => s.State).ToList();
        if (!states.Contains("default")) states.Insert(0, "default");
        if (!states.Contains(Session.State)) states.Add(Session.State);
        return states.Distinct();
    }

    private async Task SwitchStateAsync(string state)
    {
        if (state == Session.State) return;
        var file = Path.Combine(_designsDir, $"{Session.Screen}.{state}.json");
        if (File.Exists(file)) { await Session.LoadAsync(file); ApplyShell(); _saved = null; }
        else Session.NewState(state);   // unsaved variant, cloned from the current tree
    }

    private void AddState()
    {
        if (string.IsNullOrWhiteSpace(_newState)) return;
        Session.NewState(_newState.Trim());
        _newState = "";
    }

    // Rename the current (non-default) state: write the new file, drop the old one.
    private async Task RenameStateAsync(string newName)
    {
        newName = newName?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(newName) || newName == Session.State || Session.State == "default") return;
        var old = Session.State;
        Session.SetState(newName);
        await Session.SaveAsync(_designsDir);
        Store.Delete(_designsDir, $"{Session.Screen}.{old}");
        RefreshScreens();
        _renameState = "";
        _saved = null;
    }

    private void DeleteScreenAsync(ScreenRef s)
    {
        Store.Delete(_designsDir, s.FileBase);
        RefreshScreens();
    }

    private void OnChanged() { _saved = null; InvokeAsync(StateHasChanged); }

    private async Task SaveAsync()
    {
        _saved = Path.GetFileName(await Session.SaveAsync(_designsDir));
        RefreshScreens();
        StateHasChanged();
    }

    // Canvas tree rendered inline by the page so click handlers are page-bound
    // (interactive), not authored inside a child component (which isn't).
    private RenderFragment RenderNode(EditableNode node) => builder =>
    {
        var selected = Session.SelectedId == node.Id;

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "pd-node" + (selected ? " pd-sel" : ""));
        builder.AddAttribute(2, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => Session.Select(node.Id)));
        builder.AddEventStopPropagationAttribute(3, "onclick", true);

        builder.OpenElement(4, "span");
        builder.AddAttribute(5, "class", "pd-tag");
        builder.AddContent(6, node.DisplayName);
        builder.CloseElement();

        if (node.IsElement)
        {
            builder.OpenElement(7, node.Element!);
            if (!string.IsNullOrWhiteSpace(node.CssClass)) builder.AddAttribute(8, "class", node.CssClass);
            if (LayoutCss.Combine(node.Layout, node.Style) is { } css) builder.AddAttribute(9, "style", css);
            if (node.Children.Count == 0)
            {
                builder.OpenElement(10, "span");
                builder.AddAttribute(11, "class", "pd-empty");
                builder.AddContent(12, $"empty <{node.Element}> — add into it");
                builder.CloseElement();
            }
            else
            {
                foreach (var child in node.Children) builder.AddContent(13, RenderNode(child));
            }
            builder.CloseElement();
        }
        else
        {
            var type = Resolver.Resolve(node.Component!);
            builder.OpenComponent<DynamicComponent>(14);
            builder.AddComponentParameter(15, "Type", type);
            builder.AddComponentParameter(16, "Parameters", BuildParams(node, type));
            builder.CloseComponent();
        }

        builder.CloseElement();
    };

    // Raw render (Preview mode, ADR 0005): the exact DOM codegen would emit — no
    // pd-node wrapper, no tag, no empty-slot placeholder, no selection onclick — so
    // flex/grid item identity and width resolution match the generated .razor.
    private RenderFragment RenderRaw(EditableNode node) => builder =>
    {
        if (node.IsElement)
        {
            builder.OpenElement(0, node.Element!);
            if (!string.IsNullOrWhiteSpace(node.CssClass)) builder.AddAttribute(1, "class", node.CssClass);
            if (LayoutCss.Combine(node.Layout, node.Style) is { } css) builder.AddAttribute(2, "style", css);
            foreach (var child in node.Children) builder.AddContent(3, RenderRaw(child));
            builder.CloseElement();
        }
        else
        {
            var type = Resolver.Resolve(node.Component!);
            builder.OpenComponent<DynamicComponent>(4);
            builder.AddComponentParameter(5, "Type", type);
            builder.AddComponentParameter(6, "Parameters", BuildParams(node, type, preview: true));
            builder.CloseComponent();
        }
    };

    private Dictionary<string, object?> BuildParams(EditableNode node, Type type, bool preview = false)
    {
        var p = new Dictionary<string, object?>();

        // Literal params. Complex-object markers ($bind/$raw) are design-time only —
        // they can't be materialized, so skip them (the component uses its default).
        foreach (var (k, v) in node.Params)
        {
            if (v is BindExpr or RawExpr) continue;
            p[k] = v;
        }

        // @bind params: seed ephemeral local state so a bound input is previewable.
        // Never exported — bindings serialize under `bindings`, not `params`.
        foreach (var (name, _) in node.Bindings)
        {
            var prop = type.GetProperty(name);
            if (prop is null) continue;
            var key = $"{node.Id}:{name}";
            p[name] = _ephemeral.TryGetValue(key, out var val) ? val : DefaultOf(prop.PropertyType);
        }

        if (type.GetProperty("ChildContent") is not null)
        {
            if (node.Children.Count > 0)
                p["ChildContent"] = preview ? RawFrag(node.Children) : Frag(node.Children);
            else if (!preview)
                p["ChildContent"] = EmptyFrag($"empty {node.Component} — add into it");
        }

        foreach (var (slot, kids) in node.Slots)
            if (kids.Count > 0 && type.GetProperty(slot) is not null)
                p[slot] = preview ? RawFrag(kids) : Frag(kids);

        return p;
    }

    private RenderFragment RawFrag(List<EditableNode> kids) => b =>
    {
        foreach (var child in kids) b.AddContent(0, RenderRaw(child));
    };

    private readonly Dictionary<string, object?> _ephemeral = new();

    private static object? DefaultOf(Type t) =>
        t == typeof(string) ? "" :
        (Nullable.GetUnderlyingType(t) is null && t.IsValueType ? Activator.CreateInstance(t) : null);

    private RenderFragment Frag(List<EditableNode> kids) => b =>
    {
        foreach (var child in kids) b.AddContent(0, RenderNode(child));
    };

    private RenderFragment EmptyFrag(string text) => b =>
    {
        b.OpenElement(0, "span");
        b.AddAttribute(1, "class", "pd-empty");
        b.AddContent(2, text);
        b.CloseElement();
    };

    private IEnumerable<(EditableNode node, int depth)> Flatten(EditableNode n, int depth)
    {
        yield return (n, depth);
        foreach (var child in n.AllChildren)
            foreach (var pair in Flatten(child, depth + 1))
                yield return pair;
    }

    private List<ParamInfo> EditableParams(string component) =>
        Session.Info(component)?.Params
            .Where(p => p.Kind is ParamKind.Primitive or ParamKind.Enum)
            .ToList() ?? new();

    private static string LV(EditableNode n, string key) => n.Layout.GetValueOrDefault(key) ?? "";

    // <option> list for a layout select: a "(unset)" entry plus each choice, current selected.
    private RenderFragment LayoutOptions(string current, params string[] opts) => b =>
    {
        b.OpenElement(0, "option");
        b.AddAttribute(1, "value", "");
        if (string.IsNullOrEmpty(current)) b.AddAttribute(2, "selected", true);
        b.AddContent(3, "(unset)");
        b.CloseElement();
        foreach (var o in opts)
        {
            b.OpenElement(4, "option");
            b.AddAttribute(5, "value", o);
            if (current == o) b.AddAttribute(6, "selected", true);
            b.AddContent(7, o);
            b.CloseElement();
        }
    };

    private void ClearLayout(string id) => Session.ClearLayout(id);

    private void Preset(string id, params (string key, string val)[] kv)
    {
        Session.ClearLayout(id);
        foreach (var (k, v) in kv) Session.SetLayout(id, k, v);
    }

    private List<ParamInfo> EventParams(string component) =>
        Session.Info(component)?.Params.Where(p => p.Kind == ParamKind.Event).ToList() ?? new();

    private List<ParamInfo> ComplexParams(string component) =>
        Session.Info(component)?.Params.Where(p => p.Kind == ParamKind.Complex).ToList() ?? new();

    private static object? MakeBind(string? field) => string.IsNullOrWhiteSpace(field) ? null : new BindExpr(field.Trim());
    private static object? MakeRaw(string? code) => string.IsNullOrWhiteSpace(code) ? null : new RawExpr(code.Trim());

    private Type ParamType(string component, string name) =>
        Resolver.Resolve(component).GetProperty(name)!.PropertyType;

    private static Type Underlying(Type t) => Nullable.GetUnderlyingType(t) ?? t;

    private static bool IsNumeric(Type t)
    {
        var u = Underlying(t);
        return u == typeof(int) || u == typeof(long) || u == typeof(double) || u == typeof(decimal) || u == typeof(float);
    }

    private static object? ParseNum(Type t, string? s)
    {
        var u = Underlying(t);
        if (string.IsNullOrWhiteSpace(s)) return null;
        return u == typeof(int) ? int.Parse(s)
             : u == typeof(long) ? long.Parse(s)
             : u == typeof(double) ? double.Parse(s)
             : u == typeof(float) ? float.Parse(s)
             : u == typeof(decimal) ? decimal.Parse(s)
             : s;
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
