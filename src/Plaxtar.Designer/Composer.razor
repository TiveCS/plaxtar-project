        _saved = null;
    }

    private void NewScreen()
    {
        Session.New(_newName, Options.DefaultShellName);
        ApplyShell();
        _newName = "";
    }

    // States of the current screen: those saved on disk, plus `default` and the
    // in-memory current state (which may be unsaved yet).
    private IEnumerable<string> StatesForCurrentScreen()
    {
        var states = _screens.Where(s => s.Screen == Session.Screen).Select(s => s.State).ToList();
        if (!states.Contains("default")) states.Insert(0, "default");
        if (!states.Contains(Session.State)) states.Add(Session.State);
        return states.Distinct();
    }

    private async Task SwitchStateAsync(string state)
    {
        if (state == Session.State) return;
        var file = Path.Combine(_designsDir, $"{Session.Screen}.{state}.json");
        if (File.Exists(file)) { await Session.LoadAsync(file); ApplyShell(); _saved = null; }
        else Session.NewState(state);   // unsaved variant, cloned from the current tree
    }

    private void AddState()
    {
        if (string.IsNullOrWhiteSpace(_newState)) return;
        Session.NewState(_newState.Trim());
        _newState = "";
    }

    private void OnChanged() { _saved = null; InvokeAsync(StateHasChanged); }

    private async Task SaveAsync()
    {
        _saved = Path.GetFileName(await Session.SaveAsync(_designsDir));
        RefreshScreens();
        StateHasChanged();
