            var type = Resolver.Resolve(node.Component!);
            builder.OpenComponent<DynamicComponent>(60);
            builder.AddComponentParameter(61, "Type", type);
            builder.AddComponentParameter(62, "Parameters", BuildParams(node, type, preview: true));
            builder.CloseComponent();
