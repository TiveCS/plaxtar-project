    .ctx-insert { width: 240px; display: flex; flex-direction: column; gap: 8px; padding: 4px; }
    .ctx-slots { padding: 0; }
    .ctx-list { max-height: 240px; overflow: auto; display: flex; flex-direction: column; }
    .ctx-opt { display: flex; align-items: center; gap: 6px; width: 100%; text-align: left; font: inherit; font-size: 13px; border: 0; background: transparent; padding: 6px 8px; border-radius: 5px; cursor: pointer; color: #1f2937; }
    .ctx-opt:hover { background: #f3f4f6; }
    .ctx-opt.mono { font-family: ui-monospace, monospace; font-size: 12px; color: #565a66; }
    .ctx-opt .cc { margin-left: auto; font-size: 9px; color: #5b6cf0; background: #eaecfd; padding: 1px 5px; border-radius: 4px; }

    /* JS drag layer (#23): container highlighted for an "Into" drop. */
    .pl-into { outline: 2px solid #5b6cf0 !important; outline-offset: -2px; background: rgba(91,108,240,.06); }
    .lrow.pl-into { background: #eaecfd; }
</style>

@code {
    private Type? _shellType;
    private bool _preview;      // true = raw, full-width, true-fidelity render (ADR 0005)
    private string? _saved;
    private string? _importMsg;    // Download/Import (#35) status

    private string _designsDir = "";
    private List<ScreenRef> _screens = new();
    private string _newName = "";
    private string _newState = "";

    // Shell redesign (#21): which rail panel is open (None = collapsed), catalog filter,
    // Preview top-bar auto-hide state, and the shared confirm dialog for deletes.
    private enum Panel { None, Layers, Components, Elements }
    private Panel _panel = Panel.Layers;
    private bool _propsOpen = true;    // Properties is an independent right-panel toggle (#26)

    // --- Flow view (#32): read-only state machine. Mutually exclusive with Preview. ---
    private const double FlowHeaderH = 36, FlowRowH = 26;
    private bool _flow;
    private FlowGraphModel? _flowModel;
    private string? _flowModelScreen;

    private void ToggleFlow()
    {
        _flow = !_flow;
        if (_flow) { _preview = false; _flowModel = null; } // rebuild fresh on enter
    }

    private FlowGraphModel FlowModel()
    {
        if (_flowModel is null || _flowModelScreen != Session.Screen)
        {
            _flowModel = FlowGraph.Build(_designsDir, Session.Screen, Catalog, Store);
            _flowModelScreen = Session.Screen;
        }
        return _flowModel;
    }

    private double BoxHeight(FlowBox b) => FlowHeaderH + Math.Max(b.Ports.Count, 1) * FlowRowH;

    private (double W, double H) FlowBoardSize(FlowGraphModel m)
    {
        if (m.Boxes.Count == 0) return (600, 400);
        var w = m.Boxes.Max(b => b.X + FlowGraph.BoxW) + 220; // room for cross-screen chips
        var h = m.Boxes.Max(b => b.Y + BoxHeight(b)) + 80;
        return (w, h);
    }

    // A drawn transition: a bezier from a port's right edge to either a target State box's
    // left edge (same-screen) or a cross-screen chip placed to the right of the port.
    private sealed record FlowEdgeGeo(double X1, double Y1, double X2, double Y2, bool Cross, string Label);

    private IEnumerable<FlowEdgeGeo> FlowEdges(FlowGraphModel m)
    {
        foreach (var b in m.Boxes)
        {
            for (int i = 0; i < b.Ports.Count; i++)
            {
                var port = b.Ports[i];
                if (port.To is null) continue;
                var py = b.Y + FlowHeaderH + i * FlowRowH + FlowRowH / 2;
                var px = b.X + FlowGraph.BoxW;
                var cross = port.To.Contains('.');
                if (!cross && m.Boxes.FirstOrDefault(x => x.State == port.To) is { } tb)
                    yield return new FlowEdgeGeo(px, py, tb.X, tb.Y + FlowHeaderH / 2, false, port.To);
                else
                    yield return new FlowEdgeGeo(px, py, px + 44, py, true, port.To); // cross-screen / unresolved
            }
        }
    }

    private static string EdgePath(FlowEdgeGeo e)
    {
        int x1 = (int)e.X1, y1 = (int)e.Y1, x2 = (int)e.X2, y2 = (int)e.Y2;
        int c = Math.Max(40, (x2 - x1) / 2);
        return $"M {x1} {y1} C {x1 + c} {y1}, {x2 - c} {y2}, {x2} {y2}";
    }

    // --- Flow authoring (#34): drag a port onto a box (same-screen), ⋮ menu (cross-screen),
    // ✕ clear; drag a box header to reposition (persisted to <screen>.flow.json). ---
    private sealed record FlowDrag(string Kind, string FileBase, string State, string Path, string Event, double GrabX, double GrabY);
    private sealed record FlowPoint(double X, double Y);
    private FlowDrag? _flowDrag;
    private FlowDrag? _flowPin;     // port awaiting a cross-screen target from the menu
    private PaMenu? _flowMenu;

    private void FlowPortDragStart(FlowBox b, FlowPort port)
        => _flowDrag = new FlowDrag("port", b.FileBase, b.State, port.Path, port.Event, 0, 0);

    private void FlowBoxDragStart(FlowBox b, DragEventArgs e)
        => _flowDrag = new FlowDrag("box", b.FileBase, b.State, "", "", e.OffsetX, e.OffsetY);

    private async Task FlowDropOnBox(FlowBox target)
    {
        if (_flowDrag is not { Kind: "port" } d) return;   // box moves are handled on the canvas
        _flowDrag = null;
        if (target.State == d.State) return;               // no self-transition
        await FlowSetTarget(d, target.State);
    }

    private async Task FlowDropOnCanvas(DragEventArgs e)
    {
        if (_flowDrag is not { Kind: "box" } d) return;     // port drops are handled on the box
        _flowDrag = null;
        if (_dragMod is null) return;
        var pt = await _dragMod.InvokeAsync<FlowPoint?>("pointIn", ".flowcanvas", e.ClientX, e.ClientY);
        if (pt is null) return;
        await FlowGraph.WritePositionAsync(_designsDir, Session.Screen, d.State, pt.X - d.GrabX, pt.Y - d.GrabY);
        _flowModel = null; // rebuild with the new position
    }

    private Task FlowClear(FlowBox b, FlowPort port)
        => FlowSetTarget(new FlowDrag("port", b.FileBase, b.State, port.Path, port.Event, 0, 0), null);

    private async Task OpenFlowMenu(FlowBox b, FlowPort port, MouseEventArgs e)
    {
        _flowPin = new FlowDrag("port", b.FileBase, b.State, port.Path, port.Event, 0, 0);
        if (_flowMenu is not null) await _flowMenu.OpenAtAsync(e.ClientX, e.ClientY);
    }

    private async Task FlowPickCross(ScreenRef r)
    {
        if (_flowPin is { } d) { await FlowSetTarget(d, $"{r.Screen}.{r.State}"); _flowPin = null; }
    }

    // Write (or clear) a Transition target on the exact node in its State file, then rebuild
    // the board. Reuses a throwaway DesignSession so the file keeps its clean serialization
    // (empty collections omitted, events in object form).
    private async Task FlowSetTarget(FlowDrag d, string? to)
    {
        var file = Path.Combine(_designsDir, d.FileBase + ".json");
        var temp = new DesignSession(Resolver, Catalog, Options);
        await temp.LoadAsync(file);
        if (FlowGraph.Navigate(temp.Root, temp.Overlays, d.Path) is not { } node) return;
        temp.SetEventTarget(node.Id, d.Event, to);
        await temp.SaveAsync(_designsDir);
        // Keep the canvas honest if we edited the currently-loaded state.
        if (d.FileBase == $"{Session.Screen}.{Session.State}") await Session.LoadAsync(file);
        _flowModel = null; // rebuild board
    }
