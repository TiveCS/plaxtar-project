        // calls OnDropAt on drop, so no server-side ondragover/ondrop here.
        builder.AddAttribute(7, "data-node-id", node.Id);
        if (Session.CanContainNode(node)) builder.AddAttribute(8, "data-container", "true");
        // Right-click context menu (#22). stopPropagation so only the deepest node
        // under the cursor opens the menu; preventDefault suppresses the native menu.
        builder.AddAttribute(10, "oncontextmenu", EventCallback.Factory.Create<MouseEventArgs>(this, e => OpenCtx(node.Id, e)));
        builder.AddEventPreventDefaultAttribute(19, "oncontextmenu", true);
        builder.AddEventStopPropagationAttribute(29, "oncontextmenu", true);

        builder.OpenElement(11, "span");
        builder.AddAttribute(12, "class", "pd-tag");
        builder.AddContent(13, node.DisplayName);
        builder.CloseElement();

        if (node.IsText)
        {
            builder.AddContent(14, node.Text);
        }
        else if (node.IsElement)
        {
            builder.OpenElement(15, node.Element!);
            if (!string.IsNullOrWhiteSpace(node.CssClass)) builder.AddAttribute(16, "class", node.CssClass);
            if (LayoutCss.Combine(node.Layout, node.Style) is { } css) builder.AddAttribute(17, "style", css);
            var aseq = 18;
            foreach (var (k, v) in node.Attributes) builder.AddAttribute(aseq++, k, v);
            if (!node.IsVoidElement)
            {
                if (node.Children.Count == 0)
                {
                    builder.OpenElement(30, "span");
                    builder.AddAttribute(31, "class", "pd-empty");
                    builder.AddContent(32, $"empty <{node.Element}> — drop or add into it");
                    builder.CloseElement();
                }
                else
                {
                    var seq = 33;
                    foreach (var child in node.Children) builder.AddContent(seq++, RenderNode(child));
                }
            }
            builder.CloseElement();
        }
        else
        {
