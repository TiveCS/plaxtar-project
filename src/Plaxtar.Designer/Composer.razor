    // Canvas tree rendered inline by the page so click handlers are page-bound
    // (interactive), not authored inside a child component (which isn't).
    private RenderFragment RenderNode(EditableNode node) => builder =>
    {
        var selected = Session.SelectedId == node.Id;

        builder.OpenElement(0, "div");
        // Key by node Id so undo/redo (which mints new Ids) tears down and rebuilds the
        // subtree — otherwise a reused DynamicComponent keeps a param that was unset.
        builder.SetKey(node.Id);
        builder.AddAttribute(1, "class", "pd-node" + (selected ? " pd-sel" : ""));
        builder.AddAttribute(2, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => Session.Select(node.Id)));
        builder.AddEventStopPropagationAttribute(3, "onclick", true);
        // Drag & drop (#14), page-bound so the handlers are interactive. ondragover is
        // preventDefault-only (no handler) to allow the drop without spamming the circuit
        // with a render per mousemove.
        builder.AddAttribute(4, "draggable", "true");
        builder.AddAttribute(5, "ondragstart", EventCallback.Factory.Create<DragEventArgs>(this, () => BeginDragNode(node.Id)));
        builder.AddEventStopPropagationAttribute(6, "ondragstart", true);
        // Hooks for the JS drag layer (#23): it resolves the zone + draws the line and
        // calls OnDropAt on drop, so no server-side ondragover/ondrop here.
        builder.AddAttribute(7, "data-node-id", node.Id);
        if (Session.CanContainNode(node)) builder.AddAttribute(8, "data-container", "true");
        // Right-click context menu (#22). stopPropagation so only the deepest node
        // under the cursor opens the menu; preventDefault suppresses the native menu.
        builder.AddAttribute(10, "oncontextmenu", EventCallback.Factory.Create<MouseEventArgs>(this, e => OpenCtx(node.Id, e)));
        builder.AddEventPreventDefaultAttribute(19, "oncontextmenu", true);
        builder.AddEventStopPropagationAttribute(29, "oncontextmenu", true);

        builder.OpenElement(11, "span");
        builder.AddAttribute(12, "class", "pd-tag");
        builder.AddContent(13, node.DisplayName);
        builder.CloseElement();

        if (node.IsText)
        {
            builder.AddContent(14, node.Text);
        }
        else if (node.IsElement)
        {
            builder.OpenElement(15, node.Element!);
            if (!string.IsNullOrWhiteSpace(node.CssClass)) builder.AddAttribute(16, "class", node.CssClass);
            if (LayoutCss.Combine(node.Layout, node.Style) is { } css) builder.AddAttribute(17, "style", css);
            var aseq = 18;
            foreach (var (k, v) in node.Attributes) builder.AddAttribute(aseq++, k, v);
            if (!node.IsVoidElement)
            {
                if (node.Children.Count == 0)
                {
                    builder.OpenElement(30, "span");
                    builder.AddAttribute(31, "class", "pd-empty");
                    builder.AddContent(32, $"empty <{node.Element}> — drop or add into it");
                    builder.CloseElement();
                }
                else
                {
                    var seq = 33;
                    foreach (var child in node.Children) builder.AddContent(seq++, RenderNode(child));
                }
            }
            builder.CloseElement();
        }
        else
        {
            var type = Resolver.Resolve(node.Component!);
            builder.OpenComponent<DynamicComponent>(60);
            builder.AddComponentParameter(61, "Type", type);
            builder.AddComponentParameter(62, "Parameters", BuildParams(node, type));
            builder.CloseComponent();
        }

        builder.CloseElement();
    };

    // Raw render (Preview mode, ADR 0005): the exact DOM codegen would emit — no
    // pd-node wrapper, no tag, no empty-slot placeholder, no selection onclick — so
    // flex/grid item identity and width resolution match the generated .razor.
    private RenderFragment RenderRaw(EditableNode node) => builder =>
    {
        if (node.IsText)
        {
            builder.AddContent(0, node.Text);
        }
        else if (node.IsElement)
        {
            builder.OpenElement(1, node.Element!);
            if (!string.IsNullOrWhiteSpace(node.CssClass)) builder.AddAttribute(2, "class", node.CssClass);
            if (LayoutCss.Combine(node.Layout, node.Style) is { } css) builder.AddAttribute(3, "style", css);
            var aseq = 4;
            foreach (var (k, v) in node.Attributes) builder.AddAttribute(aseq++, k, v);
            if (!node.IsVoidElement)
            {
                var seq = 20;
                foreach (var child in node.Children) builder.AddContent(seq++, RenderRaw(child));
            }
            builder.CloseElement();
        }
        else
        {
            var type = Resolver.Resolve(node.Component!);
            builder.OpenComponent<DynamicComponent>(60);
            builder.SetKey(node.Id);
            builder.AddComponentParameter(61, "Type", type);
            builder.AddComponentParameter(62, "Parameters", BuildParams(node, type, preview: true));
            builder.CloseComponent();
        }
    };

    private Dictionary<string, object?> BuildParams(EditableNode node, Type type, bool preview = false)
    {
        var p = new Dictionary<string, object?>();

        // Literal params. Complex-object markers ($bind/$raw) are design-time only —
        // they can't be materialized, so skip them (the component uses its default).
        foreach (var (k, v) in node.Params)
        {
            if (v is BindExpr or RawExpr) continue;
            p[k] = v;
        }

        // @bind params: seed ephemeral local state so a bound input is previewable.
        // Never exported — bindings serialize under `bindings`, not `params`.
        foreach (var (name, _) in node.Bindings)
        {
            var prop = type.GetProperty(name);
            if (prop is null) continue;
            var key = $"{node.Id}:{name}";
            p[name] = _ephemeral.TryGetValue(key, out var val) ? val : DefaultOf(prop.PropertyType);
        }

        if (type.GetProperty("ChildContent") is not null)
        {
            if (node.Children.Count > 0)
                p["ChildContent"] = preview ? RawFrag(node.Children) : Frag(node.Children);
            else if (!preview)
                p["ChildContent"] = EmptyFrag($"empty {node.Component} — add into it");
        }

        foreach (var (slot, kids) in node.Slots)
            if (kids.Count > 0 && type.GetProperty(slot) is not null)
                p[slot] = preview ? RawFrag(kids) : Frag(kids);

        return p;
    }

    private RenderFragment RawFrag(List<EditableNode> kids) => b =>
    {
        var seq = 0;
        foreach (var child in kids) b.AddContent(seq++, RenderRaw(child));
    };

    private readonly Dictionary<string, object?> _ephemeral = new();

    private static object? DefaultOf(Type t) =>
        t == typeof(string) ? "" :
        (Nullable.GetUnderlyingType(t) is null && t.IsValueType ? Activator.CreateInstance(t) : null);

    private RenderFragment Frag(List<EditableNode> kids) => b =>
    {
        var seq = 0;
        foreach (var child in kids) b.AddContent(seq++, RenderNode(child));
    };

    private RenderFragment EmptyFrag(string text) => b =>
    {
        b.OpenElement(0, "span");
        b.AddAttribute(1, "class", "pd-empty");
        b.AddContent(2, text);
        b.CloseElement();
    };

    private IEnumerable<(EditableNode node, int depth)> Flatten(EditableNode n, int depth)
    {
        yield return (n, depth);
        foreach (var child in n.AllChildren)
            foreach (var pair in Flatten(child, depth + 1))
                yield return pair;
    }

    private List<ParamInfo> EditableParams(string component) =>
        Session.Info(component)?.Params
            .Where(p => p.Kind is ParamKind.Primitive or ParamKind.Enum)
            .ToList() ?? new();

    private static string LV(EditableNode n, string key) => n.Layout.GetValueOrDefault(key) ?? "";

    // <option> list for a layout select: a "(unset)" entry plus each choice, current selected.
    private RenderFragment LayoutOptions(string current, params string[] opts) => b =>
    {
        b.OpenElement(0, "option");
        b.AddAttribute(1, "value", "");
        if (string.IsNullOrEmpty(current)) b.AddAttribute(2, "selected", true);
        b.AddContent(3, "(unset)");
        b.CloseElement();
        foreach (var o in opts)
        {
            b.OpenElement(4, "option");
            b.AddAttribute(5, "value", o);
            if (current == o) b.AddAttribute(6, "selected", true);
            b.AddContent(7, o);
            b.CloseElement();
        }
    };

    private void ClearLayout(string id) => Session.ClearLayout(id);

    private void Preset(string id, params (string key, string val)[] kv)
    {
        Session.ClearLayout(id);
        foreach (var (k, v) in kv) Session.SetLayout(id, k, v);
    }

    private List<ParamInfo> EventParams(string component) =>
        Session.Info(component)?.Params.Where(p => p.Kind == ParamKind.Event).ToList() ?? new();

    private List<ParamInfo> ComplexParams(string component) =>
        Session.Info(component)?.Params.Where(p => p.Kind == ParamKind.Complex).ToList() ?? new();

    private static object? MakeBind(string? field) => string.IsNullOrWhiteSpace(field) ? null : new BindExpr(field.Trim());
    private static object? MakeRaw(string? code) => string.IsNullOrWhiteSpace(code) ? null : new RawExpr(code.Trim());

    private Type ParamType(string component, string name) =>
        Resolver.Resolve(component).GetProperty(name)!.PropertyType;

    private static Type Underlying(Type t) => Nullable.GetUnderlyingType(t) ?? t;

    private static bool IsNumeric(Type t)
    {
        var u = Underlying(t);
        return u == typeof(int) || u == typeof(long) || u == typeof(double) || u == typeof(decimal) || u == typeof(float);
    }

    private static object? ParseNum(Type t, string? s)
    {
        var u = Underlying(t);
        if (string.IsNullOrWhiteSpace(s)) return null;
        return u == typeof(int) ? int.Parse(s)
             : u == typeof(long) ? long.Parse(s)
             : u == typeof(double) ? double.Parse(s)
             : u == typeof(float) ? float.Parse(s)
             : u == typeof(decimal) ? decimal.Parse(s)
             : s;
    }

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        CancelBarTimer();
        _dotnetRef?.Dispose();
        _ = _dragMod?.DisposeAsync().AsTask();
    }
}
