    private async Task OnImport(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        _importMsg = null;
        // ZipArchive needs a seekable stream; buffer the upload first (cap 25 MB).
        using var ms = new MemoryStream();
        await using (var up = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024)) await up.CopyToAsync(ms);
        ms.Position = 0;
        try
        {
            var res = await DesignBundle.ImportAsync(ms, file.Name, _designsDir);
            RefreshScreens();
            _saved = null;
            _importMsg = res.Files == 0 ? "nothing imported (empty or unsupported file)"
                                        : $"imported {res.Files} file(s), {res.Screens} screen(s)";
        }
        catch (Exception ex) { _importMsg = $"import failed: {ex.Message}"; }
        StateHasChanged();
    }

