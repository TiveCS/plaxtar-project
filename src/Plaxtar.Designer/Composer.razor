    private async Task CtxInsertElement(string targetId, string tag) { Session.InsertElementInto(targetId, _ctxSlot, tag); await CloseCtx(); }
    private async Task CtxInsertText(string targetId) { Session.InsertTextInto(targetId, _ctxSlot); await CloseCtx(); }

    private async Task CloseCtx()
