    // JS drag layer (#23, ADR 0007): the client module resolves the drop zone and
    // calls OnDropAt once, on drop. The payload is the _drag* state set server-side by
    // the existing @ondragstart handlers.
    private DotNetObjectReference<Composer>? _dotnetRef;
    private IJSObjectReference? _dragMod;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _dotnetRef = DotNetObjectReference.Create(this);
        _dragMod = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Plaxtar.Designer/pl-drag.js");
        await _dragMod.InvokeVoidAsync("init", _dotnetRef);
        await LoadQuick();
    }

    [JSInvokable]
    public async Task OnDropAt(string? targetId, string pos)
    {
        var p = pos switch { "before" => DropPos.Before, "after" => DropPos.After, _ => DropPos.Into };
        var tid = string.IsNullOrEmpty(targetId) ? null : targetId;
        if (_dragText) Session.DropNewAt(tid, p, new EditableNode { Text = "text" });
        else if (_dragComponent is { } c) Session.DropNewAt(tid, p, new EditableNode { Component = c, Src = Session.Info(c)?.Src });
        else if (_dragElement is { } e) Session.DropNewAt(tid, p, new EditableNode { Element = e });
        else if (_dragNodeId is { } n) Session.MoveNodeTo(n, tid, p);
        ClearDrag();
        await InvokeAsync(StateHasChanged);
    }

    // Keyboard shortcuts (#28), dispatched from the JS keydown layer.
    [JSInvokable]
    public async Task OnShortcut(string cmd)
    {
        switch (cmd)
        {
            case "delete": if (Session.SelectedId is { } id) Session.Remove(id); break;   // immediate (undoable)
            case "save": await SaveAsync(); break;
            case "preview": TogglePreview(); break;
            case "togglePanels": TogglePanels(); break;
            case "undo": Session.Undo(); break;
            case "redo": Session.Redo(); break;
            default:
                if (cmd.StartsWith("quick") && int.TryParse(cmd.AsSpan(5), out var qn) && qn is >= 1 and <= 9)
                    InsertQuick(qn - 1);
                break;
        }
        await InvokeAsync(StateHasChanged);
    }

    // Ctrl+B: hide all panels for a full-canvas Edit view, then restore what was open.
    private bool _panelsHidden;
    private Panel _panelBefore;
    private bool _propsBefore;
    private void TogglePanels()
    {
        if (_panel != Panel.None || _propsOpen)
        {
            _panelBefore = _panel; _propsBefore = _propsOpen;
            _panel = Panel.None; _propsOpen = false; _panelsHidden = true;
        }
        else if (_panelsHidden)
        {
            _panel = _panelBefore; _propsOpen = _propsBefore; _panelsHidden = false;
        }
        else
        {
            _panel = Panel.Layers; _propsOpen = true;
        }
