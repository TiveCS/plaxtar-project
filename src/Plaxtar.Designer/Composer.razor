        if (!await _dialog.ConfirmAsync("Delete state?", $"Delete state “{state}” of {Session.Screen}?")) return;
        Store.Delete(_designsDir, $"{Session.Screen}.{state}");
        RefreshScreens();
        if (Session.State == state) await SwitchStateAsync("default");
