@page "/designer"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject DesignSession Session
@inject ComponentCatalog Catalog
@inject ComponentTypeResolver Resolver
@inject ScreenStore Store
@inject PlaxtarDesignerOptions Options
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Composer — @Session.Screen</PageTitle>

<div class="composer@(_preview ? " is-preview" : "")">
    <!-- toolbar -->
    <div class="bar@(_preview && _barHidden ? " bar-hidden" : "")"
         @onmouseenter="ShowBar" @onmouseleave="HideBarSoon">
        <span class="brand">Plaxtar</span>
        @if (!_preview)
        {
            <PaCombobox Items="ScreenNames()" Selected="@Session.Screen"
                        SelectedChanged="OnPickScreen" OnDelete="OnDeleteScreen"
                        Placeholder="screen…" SearchPlaceholder="Search screens…">
                <Footer>
                    <div class="newrow">
                        <input placeholder="new screen name" value="@_newName"
                               @oninput="e => _newName = e.Value?.ToString() ?? string.Empty" />
                        <PaButton Variant="PaButton.Kind.Primary" OnClick="NewScreen">+ New</PaButton>
                    </div>
                </Footer>
            </PaCombobox>
            <PaCombobox Items="StatesForCurrentScreen().ToList()" Selected="@Session.State"
                        SelectedChanged="OnPickState" OnDelete="OnDeleteState"
                        Placeholder="state…" SearchPlaceholder="Search states…">
                <Footer>
                    <div class="newrow">
                        <input placeholder="new state (e.g. modal-open)" value="@_newState"
                               @oninput="e => _newState = e.Value?.ToString() ?? string.Empty" />
                        <PaButton Variant="PaButton.Kind.Primary" OnClick="AddState">+ New</PaButton>
                    </div>
                </Footer>
            </PaCombobox>
        }
        <span class="spacer"></span>
        @if (_saved is not null) { <span class="okmsg">saved → @_saved</span> }
        <PaButton OnClick="TogglePreview" Title="Preview = raw, full-width, true-fidelity (non-interactive)">@(_preview ? "✎ Edit" : "◱ Preview")</PaButton>
        <PaButton Variant="PaButton.Kind.Primary" OnClick="SaveAsync">Save</PaButton>
    </div>

    <div class="stage">
        @* Icon rail + one swappable floating panel (issue #21, ADR 0006). In Edit the
           rail/panels/props float OVER a full-width canvas; Preview hides all chrome. *@
        @if (!_preview)
        {
            <div class="rail">
                <PaTooltip Text="Layers"><PaIconButton Title="Layers" Active="@(_panel == Panel.Layers)" OnClick="() => TogglePanel(Panel.Layers)">&#9776;</PaIconButton></PaTooltip>
                <PaTooltip Text="Components"><PaIconButton Title="Components" Active="@(_panel == Panel.Components)" OnClick="() => TogglePanel(Panel.Components)">&#9635;</PaIconButton></PaTooltip>
                <PaTooltip Text="Elements"><PaIconButton Title="Elements" Active="@(_panel == Panel.Elements)" OnClick="() => TogglePanel(Panel.Elements)">&#9671;</PaIconButton></PaTooltip>
            </div>

            @if (_panel != Panel.None)
            {
                <div class="dock dock-left">
                    <PaPanel Title="@_panel.ToString()">
                        @if (_panel == Panel.Layers)
                        {
                            @foreach (var (node, depth) in Flatten(Session.Root, 0))
                            {
                                <button type="button" class="lrow @(Session.SelectedId == node.Id ? "lsel" : "")"
                                        style="padding-left:@(depth * 14 + 8)px"
                                        draggable="true" data-node-id="@node.Id"
                                        data-container="@(Session.CanContainNode(node) ? "true" : null)"
                                        @ondragstart="() => BeginDragNode(node.Id)"
                                        @oncontextmenu:preventDefault="true" @oncontextmenu="e => OpenCtx(node.Id, e)"
                                        @onclick="() => Session.Select(node.Id)">
                                    <span class="lname">@node.DisplayName</span>
                                    @if (node.Children.Count > 0) { <span class="lc">@node.Children.Count</span> }
                                </button>
                            }
                            @if (Session.Overlays.Count > 0)
                            {
                                <div class="ph layers-h">Overlays</div>
                                @foreach (var ov in Session.Overlays)
                                {
                                    @foreach (var (node, depth) in Flatten(ov, 0))
                                    {
                                        <button type="button" class="lrow @(Session.SelectedId == node.Id ? "lsel" : "")"
                                                style="padding-left:@(depth * 14 + 8)px"
                                                @onclick="() => Session.Select(node.Id)">
                                            <span class="lname">@node.DisplayName</span>
                                            @if (node.Children.Count > 0) { <span class="lc">@node.Children.Count</span> }
                                        </button>
                                    }
                                }
                            }
                        }
                        else if (_panel == Panel.Components)
                        {
                            <div class="pfilter"><PaSearchBar @bind-Value="_catQ" Placeholder="Filter components…" /></div>
                            @foreach (var c in FilteredCatalog())
                            {
                                <div class="pcat">
                                    <button class="pitem" draggable="true" @ondragstart="() => BeginDragCatalog(c.Name)"
                                            @onclick="() => Session.Add(c.Name)">
                                        @c.Name
                                        @if (Session.CanContain(c.Name)) { <span class="cc">container</span> }
                                    </button>
                                    <button class="ovbtn" title="add as overlay" @onclick="() => Session.AddOverlay(c.Name)">&#10697;</button>
                                </div>
                            }
                            @if (!FilteredCatalog().Any()) { <p class="muted">No components match.</p> }
                        }
                        else
                        {
                            <button class="pitem" draggable="true" @ondragstart="() => BeginDragText()"
                                    @onclick="() => Session.AddText()">&#8220;Text&#8221; <span class="cc">text</span></button>
                            <div class="newrow">
                                <input placeholder="any tag (e.g. table)" value="@_newTag"
                                       @oninput="e => _newTag = e.Value?.ToString() ?? string.Empty" />
                                <PaButton Variant="PaButton.Kind.Primary" OnClick="AddFreeTag">+ Tag</PaButton>
                            </div>
                            @foreach (var (group, tags) in HtmlTags.Palette)
                            {
                                <div class="egroup">
                                    <span class="eglabel">@group</span>
                                    @foreach (var t in tags)
                                    {
                                        <button class="etag" draggable="true" @ondragstart="() => BeginDragElement(t)"
                                                @onclick="() => Session.AddElement(t)">@t</button>
                                    }
                                </div>
                            }
                        }
                    </PaPanel>
                </div>
            }
        }

        <!-- canvas (full width; panels float over it) -->
        <div class="canvas" @onclick="() => Session.Select(null)">
            <LayoutView Layout="_shellType">
                @* @if/else (not a ternary) so each mode is its own sequence region. *@
                @if (_preview) { @RenderRaw(Session.Root) }
                else { @RenderNode(Session.Root) }
            </LayoutView>
            @if (Session.Overlays.Count > 0)
            {
                <div class="ov-layer">
                    @foreach (var ov in Session.Overlays)
                    {
                        <div class="ov-item">
                            @if (_preview) { @RenderRaw(ov) }
                            else { @RenderNode(ov) }
                        </div>
                    }
                </div>
            }
        </div>

        <!-- props (floating right dock) -->
        @if (!_preview)
        {
            <div class="dock dock-right">
                <PaPanel Title="Properties">
            @if (Session.Selected is { } sel)
            {
                <div class="ptarget">
                    @sel.DisplayName
                    <div class="pactions">
                        <button title="up" @onclick="() => Session.Move(sel.Id, -1)">↑</button>
                        <button title="down" @onclick="() => Session.Move(sel.Id, 1)">↓</button>
                        <button title="remove" class="del" @onclick="() => Session.Remove(sel.Id)">✕</button>
                    </div>
                </div>

                @if (sel.IsText)
                {
                    <div class="prow">
                        <label>text content</label>
                        <textarea class="txtnode" rows="3"
                                  @onchange="e => Session.SetText(sel.Id, e.Value?.ToString())">@sel.Text</textarea>
                    </div>
                }
                else if (sel.IsElement)
                {
                    var disp = LV(sel, "display");
                    var pos = LV(sel, "position");
                    <div class="ph slots-h">Layout</div>
                    <div class="slotpick">
                        <button class="slotbtn" @onclick="() => ClearLayout(sel.Id)">clear</button>
                        <button class="slotbtn" @onclick='() => Preset(sel.Id, ("display","flex"),("direction","row"),("gap","12px"))'>flex row</button>
                        <button class="slotbtn" @onclick='() => Preset(sel.Id, ("display","flex"),("direction","column"),("gap","12px"))'>flex col</button>
                        <button class="slotbtn" @onclick='() => Preset(sel.Id, ("display","grid"),("columns","repeat(2,1fr)"),("gap","12px"))'>grid 2</button>
                        <button class="slotbtn" @onclick='() => Preset(sel.Id, ("display","grid"),("columns","repeat(3,1fr)"),("gap","12px"))'>grid 3</button>
                    </div>

                    <div class="prow">
                        <label>display</label>
                        <select @onchange='e => Session.SetLayout(sel.Id, "display", e.Value?.ToString())'>
                            @LayoutOptions(disp, "block", "flex", "inline-flex", "grid", "none")
                        </select>
                    </div>

                    @if (disp is "flex" or "inline-flex")
                    {
                        <div class="prow">
                            <label>direction</label>
                            <select @onchange='e => Session.SetLayout(sel.Id, "direction", e.Value?.ToString())'>
                                @LayoutOptions(LV(sel, "direction"), "row", "column")
                            </select>
                        </div>
                        <div class="prow">
                            <label>wrap</label>
                            <select @onchange='e => Session.SetLayout(sel.Id, "wrap", e.Value?.ToString())'>
                                @LayoutOptions(LV(sel, "wrap"), "nowrap", "wrap")
                            </select>
                        </div>
                        <div class="prow">
                            <label>justify</label>
                            <select @onchange='e => Session.SetLayout(sel.Id, "justify", e.Value?.ToString())'>
                                @LayoutOptions(LV(sel, "justify"), "start", "center", "end", "space-between", "space-around")
                            </select>
                        </div>
                        <div class="prow">
                            <label>align</label>
                            <select @onchange='e => Session.SetLayout(sel.Id, "align", e.Value?.ToString())'>
                                @LayoutOptions(LV(sel, "align"), "stretch", "start", "center", "end")
                            </select>
                        </div>
                    }
                    @if (disp == "grid")
                    {
                        <div class="prow">
                            <label>columns</label>
                            <input type="text" value="@LV(sel, "columns")" placeholder="repeat(2,1fr)"
                                   @onchange='e => Session.SetLayout(sel.Id, "columns", e.Value?.ToString())' />
                        </div>
                        <div class="prow">
                            <label>rows</label>
                            <input type="text" value="@LV(sel, "rows")" placeholder="auto"
                                   @onchange='e => Session.SetLayout(sel.Id, "rows", e.Value?.ToString())' />
                        </div>
                    }
                    @if (disp is "flex" or "inline-flex" or "grid")
                    {
                        <div class="prow">
                            <label>gap</label>
                            <input type="text" value="@LV(sel, "gap")" placeholder="12px"
                                   @onchange='e => Session.SetLayout(sel.Id, "gap", e.Value?.ToString())' />
                        </div>
                    }

                    <div class="ph slots-h">Size &amp; spacing</div>
                    <div class="lgrid">
                        <div><label>width</label><input type="text" value="@LV(sel, "width")" placeholder="auto / 100% / 320px"
                                @onchange='e => Session.SetLayout(sel.Id, "width", e.Value?.ToString())' /></div>
                        <div><label>min</label><input type="text" value="@LV(sel, "minWidth")" placeholder="min-width"
                                @onchange='e => Session.SetLayout(sel.Id, "minWidth", e.Value?.ToString())' /></div>
                        <div><label>max</label><input type="text" value="@LV(sel, "maxWidth")" placeholder="max-width"
                                @onchange='e => Session.SetLayout(sel.Id, "maxWidth", e.Value?.ToString())' /></div>
                        <div><label>padding</label><input type="text" value="@LV(sel, "padding")" placeholder="16px"
                                @onchange='e => Session.SetLayout(sel.Id, "padding", e.Value?.ToString())' /></div>
                        <div><label>margin</label><input type="text" value="@LV(sel, "margin")" placeholder="0 auto"
                                @onchange='e => Session.SetLayout(sel.Id, "margin", e.Value?.ToString())' /></div>
                    </div>

                    <div class="ph slots-h">Position</div>
                    <div class="prow">
                        <select @onchange='e => Session.SetLayout(sel.Id, "position", e.Value?.ToString())'>
                            @LayoutOptions(pos, "static", "relative", "sticky", "fixed", "absolute")
                        </select>
                    </div>
                    @if (pos is not ("" or "static"))
                    {
                        <div class="lgrid">
                            <div><label>top</label><input type="text" value="@LV(sel, "top")"
                                    @onchange='e => Session.SetLayout(sel.Id, "top", e.Value?.ToString())' /></div>
                            <div><label>right</label><input type="text" value="@LV(sel, "right")"
                                    @onchange='e => Session.SetLayout(sel.Id, "right", e.Value?.ToString())' /></div>
                            <div><label>bottom</label><input type="text" value="@LV(sel, "bottom")"
                                    @onchange='e => Session.SetLayout(sel.Id, "bottom", e.Value?.ToString())' /></div>
                            <div><label>left</label><input type="text" value="@LV(sel, "left")"
                                    @onchange='e => Session.SetLayout(sel.Id, "left", e.Value?.ToString())' /></div>
                        </div>
                    }

                    <div class="ph slots-h">Attributes</div>
                    @foreach (var kv in sel.Attributes.ToList())
                    {
                        <div class="attrrow">
                            <input class="attrk" value="@kv.Key"
                                   @onchange='e => Session.RenameAttribute(sel.Id, kv.Key, e.Value?.ToString() ?? string.Empty)' />
                            <input class="attrv" value="@kv.Value"
                                   @onchange='e => Session.SetAttribute(sel.Id, kv.Key, e.Value?.ToString())' />
                            <button class="attrx" title="remove" @onclick="() => Session.SetAttribute(sel.Id, kv.Key, null)">✕</button>
                        </div>
                    }
                    <div class="attrrow">
                        <input class="attrk" placeholder="data-testid" value="@_attrKey"
                               @oninput="e => _attrKey = e.Value?.ToString() ?? string.Empty" />
                        <input class="attrv" placeholder="value" value="@_attrVal"
                               @oninput="e => _attrVal = e.Value?.ToString() ?? string.Empty" />
                        <button class="attrx add" title="add" @onclick="() => AddAttr(sel.Id)">+</button>
                    </div>

                    <div class="ph slots-h">Escape hatches</div>
                    <div class="prow">
                        <label>class</label>
                        <input type="text" value="@sel.CssClass" placeholder="e.g. grid grid-cols-2 gap-4"
                               @onchange="e => Session.SetClass(sel.Id, e.Value?.ToString())" />
                    </div>
                    <div class="prow">
                        <label>style (raw, wins)</label>
                        <input type="text" value="@sel.Style" placeholder="e.g. box-shadow:0 1px 2px #0002"
                               @onchange="e => Session.SetStyle(sel.Id, e.Value?.ToString())" />
                    </div>
                }
                else
                {
                var slots = Session.NamedSlots(sel.Component);
                var hasCC = Session.CanContain(sel.Component!);
                @if (hasCC || slots.Count > 0)
                {
                    <div class="ph slots-h">Insert into</div>
                    <div class="slotpick">
                        @if (hasCC)
                        {
                            <button class="slotbtn @(Session.ActiveSlot is null ? "act" : "")"
                                    @onclick="() => Session.SelectSlot(null)">ChildContent (@sel.Children.Count)</button>
                        }
                        @foreach (var sn in slots)
                        {
                            var cnt = sel.Slots.TryGetValue(sn, out var l) ? l.Count : 0;
                            <button class="slotbtn @(Session.ActiveSlot == sn ? "act" : "")"
                                    @onclick="() => Session.SelectSlot(sn)">@sn (@cnt)</button>
                        }
                    </div>
                }

                var editable = EditableParams(sel.Component!);
                @if (editable.Count == 0)
                {
                    <p class="muted">no primitive/enum params</p>
                }
                else
                {
                    @foreach (var pi in editable)
                    {
                        var ptype = ParamType(sel.Component, pi.Name);
                        var current = sel.Params.GetValueOrDefault(pi.Name);
                        <div class="prow">
                            <label>@pi.Name <span class="ptype">@pi.Type</span></label>
                            @if (pi.Kind == ParamKind.Enum)
                            {
                                <select @onchange="e => Session.SetParam(sel.Id, pi.Name, Enum.Parse(Underlying(ptype), e.Value!.ToString()!))">
                                    @foreach (var opt in pi.EnumOptions!)
                                    {
                                        <option value="@opt" selected="@(current?.ToString() == opt)">@opt</option>
                                    }
                                </select>
                            }
                            else if (ptype == typeof(bool))
                            {
                                <input type="checkbox" checked="@((current as bool?) ?? false)"
                                       @onchange="e => Session.SetParam(sel.Id, pi.Name, (bool)e.Value!)" />
                            }
                            else if (IsNumeric(ptype))
                            {
                                <input type="number" value="@current"
                                       @onchange="e => Session.SetParam(sel.Id, pi.Name, ParseNum(ptype, e.Value?.ToString()))" />
                            }
                            else
                            {
                                <input type="text" value="@current"
                                       @onchange="e => Session.SetParam(sel.Id, pi.Name, e.Value?.ToString())" />
                            }
                            @if (pi.Bindable)
                            {
                                <input class="bindbox" type="text" placeholder="@("@bind") → field"
                                       value="@(sel.Bindings.GetValueOrDefault(pi.Name))"
                                       @onchange="e => Session.SetBinding(sel.Id, pi.Name, e.Value?.ToString())" />
                            }
                        </div>
                    }
                }

                var events = EventParams(sel.Component!);
                @if (events.Count > 0)
                {
                    <div class="ph slots-h">Events</div>
                    @foreach (var ev in events)
                    {
                        <div class="prow">
                            <label>@ev.Name <span class="ptype">@ev.Type</span></label>
                            <input type="text" placeholder="handler name e.g. HandleClick"
                                   value="@(sel.Events.GetValueOrDefault(ev.Name))"
                                   @onchange="e => Session.SetEvent(sel.Id, ev.Name, e.Value?.ToString())" />
                        </div>
                    }
                }

                var complex = ComplexParams(sel.Component!);
                @if (complex.Count > 0)
                {
                    <div class="ph slots-h">Complex</div>
                    @foreach (var cp in complex)
                    {
                        var cur = sel.Params.GetValueOrDefault(cp.Name);
                        <div class="prow">
                            <label>@cp.Name <span class="ptype">@cp.Type</span></label>
                            <input type="text" placeholder="$bind → field"
                                   value="@((cur as BindExpr)?.Field)"
                                   @onchange="e => Session.SetComplex(sel.Id, cp.Name, MakeBind(e.Value?.ToString()))" />
                            <input class="rawbox" type="text" placeholder="$raw → new Foo{ }"
                                   value="@((cur as RawExpr)?.Code)"
                                   @onchange="e => Session.SetComplex(sel.Id, cp.Name, MakeRaw(e.Value?.ToString()))" />
                        </div>
                    }
                }
                }
            }
            else
            {
                <p class="muted">Click a node on the canvas or in Layers. Drag a Component/Element in to add it.</p>
            }
                </PaPanel>
            </div>
        }

        @* Preview: a top hover strip re-reveals the auto-hidden bar. *@
        @if (_preview) { <div class="barzone" @onmouseenter="ShowBar"></div> }
    </div>

    <PaDialog @ref="_dialog" />

    @* Right-click context menu (#22), page-driven so it works on builder-rendered
       canvas nodes and Layers rows alike. Insert is slot-aware for components. *@
    <PaMenu @ref="_ctxMenu" Trigger="none">
        <ChildContent>
            @if (Session.Selected is { } t)
            {
                @if (!_ctxShowInsert)
                {
                    <PaMenuItem Icon="+" KeepOpen="true" OnClick="() => _ctxShowInsert = true">Insert…</PaMenuItem>
                    <PaMenuItem Icon="&#9112;" OnClick="() => Session.Duplicate(t.Id)">Duplicate</PaMenuItem>
                    <PaMenuItem Icon="&#10697;" OnClick="() => Session.AddNodeAsOverlay(t.Id)">Add as overlay</PaMenuItem>
                    <PaMenuItem Icon="&#10005;" Danger="true" OnClick="() => CtxDelete(t)">Delete</PaMenuItem>
                }
                else
                {
                    var slots = t.IsComponent ? Session.NamedSlots(t.Component) : (IReadOnlyList<string>)Array.Empty<string>();
                    var hasBody = t.IsComponent ? Session.CanContain(t.Component!) : (t.IsElement && !t.IsVoidElement);
                    <div class="ctx-insert">
                        @if (t.IsComponent && (hasBody || slots.Count > 0))
                        {
                            <div class="slotpick ctx-slots">
                                @if (hasBody)
                                {
                                    <button class="slotbtn @(_ctxSlot is null ? "act" : "")" @onclick="() => _ctxSlot = null">Body</button>
                                }
                                @foreach (var sn in slots)
                                {
                                    <button class="slotbtn @(_ctxSlot == sn ? "act" : "")" @onclick="() => _ctxSlot = sn">@sn</button>
                                }
                            </div>
                        }
                        <PaSearchBar @bind-Value="_ctxQuery" Placeholder="Insert component / element…" />
                        <div class="ctx-list">
                            @foreach (var c in CtxComponents())
                            {
                                <button class="ctx-opt" @onclick="() => CtxInsertComponent(t.Id, c.Name)">
                                    @c.Name @if (Session.CanContain(c.Name)) { <span class="cc">container</span> }
                                </button>
                            }
                            @foreach (var tag in CtxElements())
                            {
                                <button class="ctx-opt mono" @onclick="() => CtxInsertElement(t.Id, tag)">&lt;@tag&gt;</button>
                            }
                            @if (CtxTextMatches())
                            {
                                <button class="ctx-opt" @onclick="() => CtxInsertText(t.Id)">&#8220;Text&#8221;</button>
                            }
                            @if (!CtxComponents().Any() && !CtxElements().Any() && !CtxTextMatches())
                            {
                                <div class="muted">No matches.</div>
                            }
                        </div>
                    </div>
                }
            }
        </ChildContent>
    </PaMenu>
</div>

<style>
    /* Full-bleed: own the viewport so the host's body margin / padding never insets
       the design surface (Preview must match the real app's edge-to-edge width). */
    .composer { position: fixed; inset: 0; background: #fff; font-family: system-ui, sans-serif; display: flex; flex-direction: column; z-index: 1; }

    /* Top bar. In Preview it floats over the canvas and auto-hides (ADR 0006). */
    .bar { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-bottom: 1px solid #e2e5ec; background: #fff; z-index: 90; }
    .is-preview .bar { position: absolute; top: 0; left: 0; right: 0; transition: transform .25s ease; box-shadow: 0 2px 10px rgba(17,24,39,.08); }
    .bar-hidden { transform: translateY(-100%); }
    .brand { font-weight: 700; color: #1f2430; margin-right: 4px; }
    .spacer { flex: 1; }
    .okmsg { font-size: 12px; color: #16884a; }
    .newrow { display: flex; gap: 6px; align-items: center; }
    .newrow input { flex: 1; min-width: 0; font: inherit; font-size: 12px; padding: 5px 8px; border: 1px solid #d1d5db; border-radius: 6px; }

    /* Stage: the canvas fills it at true full width; rail + docks float over it. */
    .stage { position: relative; flex: 1; min-height: 0; }
    .canvas { position: absolute; inset: 0; overflow: auto; background: #eef0f4; }
    .barzone { position: absolute; top: 0; left: 0; right: 0; height: 10px; z-index: 85; }
    .rail { position: absolute; top: 12px; left: 12px; z-index: 30; display: flex; flex-direction: column; gap: 4px; padding: 5px; background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; box-shadow: 0 8px 24px rgba(17,24,39,.12); }
    .dock { position: absolute; top: 12px; bottom: 12px; z-index: 25; display: flex; }
    .dock > * { flex: 1; min-height: 0; }
    .dock-left { left: 62px; width: 256px; }
    .dock-right { right: 12px; width: 272px; }
    .pfilter { padding: 2px 2px 8px; }

    .ph { font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: #8a8f9c; font-weight: 600; padding: 6px 4px; }
    .pitem { display: flex; align-items: center; gap: 6px; width: 100%; text-align: left; font: inherit; font-size: 13px; border: 0; background: transparent; padding: 7px 8px; border-radius: 6px; cursor: pointer; }
    .pitem:hover { background: #eef0f4; }
    .pitem .cc { margin-left: auto; font-size: 9px; color: #5b6cf0; background: #eaecfd; padding: 1px 5px; border-radius: 4px; }
    .srow { display: flex; align-items: center; border-radius: 6px; }
    .srow:hover { background: #eef0f4; }
